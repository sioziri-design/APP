                  title="やり直す"

                  className={\`${FOCUS} p-1.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-100 disabled:opacity-40\`}

                \>

                  \<RotateCw className="w-3.5 h-3.5" aria-hidden="true" /\>

                \</button\>

              \</div\>

            )}

          \</div\>

          {/\* 書き出しボタングループ \*/}

          {outputHtml && (

            \<div className="flex flex-wrap items-center gap-1.5"\>

              \<ToolbarButton onClick={handleCopyRich} icon={Copy} title="書式を保ったままWord等に貼り付け"\>

                Wordへコピー

              \</ToolbarButton\>

              \<ToolbarButton onClick={handleExportWord} icon={Download} variant="emerald" title="Wordファイル(.doc)として保存"\>

                Word保存(.doc)

              \</ToolbarButton\>

              \<ToolbarButton onClick={handleExportPdf} icon={FileDown} variant="dark" disabled={busy} title="PDFファイルとしてダウンロード"\>

                PDF出力

              \</ToolbarButton\>

              \<ToolbarButton onClick={handlePrint} icon={Printer} title="ブラウザの印刷ダイアログを開く"\>

                印刷

              \</ToolbarButton\>

            \</div\>

          )}

        \</div\>

        {/\* 統計・ステータスサブバー \*/}

        {outputHtml && (

          \<div className="no-print px-4 py-2 bg-slate-100/80 border-b border-slate-200 flex flex-wrap items-center justify-between gap-2 text-\[11px\] text-slate-600"\>

            \<div className="flex items-center gap-3"\>

              \<span className="font-semibold"\>

                形式: \<strong className="text-slate-800"\>{formatTitle}\</strong\>

              \</span\>

              \<span\>｜\</span\>

              \<span\>

                文字数: \<strong className="text-slate-800"\>{outputStats.chars.toLocaleString()}字\</strong\>

              \</span\>

              \<span\>｜\</span\>

              \<span\>

                表・ボックス数: \<strong className="text-slate-800"\>{outputStats.tables}個\</strong\>

              \</span\>

              \<span\>｜\</span\>

              \<span\>

                A4換算目安: \<strong className="text-slate-800"\>約{outputStats.pages}枚\</strong\>

              \</span\>

            \</div\>

            \<div className="flex items-center gap-2"\>

              \<button

                type="button"

                onClick={handleExportHtmlFile}

                className="text-emerald-700 hover:underline font-semibold flex items-center gap-1"

              \>

                \<FileCode className="w-3 h-3" aria-hidden="true" /\>

                HTML保存

              \</button\>

            \</div\>

          \</div\>

        )}

        {/\* AIワンクリック・ブラッシュアップバー \*/}

        {outputHtml && !busy && (

          \<div className="no-print px-4 py-2.5 bg-emerald-50/50 border-b border-emerald-100 flex flex-col gap-2"\>

            \<div className="flex flex-wrap items-center gap-1.5"\>

              \<span className="text-\[11px\] font-bold text-emerald-900 flex items-center gap-1 mr-1"\>

                \<Wand2 className="w-3.5 h-3.5 text-emerald-600" aria-hidden="true" /\>

                AI追加ブラッシュアップ:

              \</span\>

              {QUICK_REFINEMENTS.map((item) =\> (

                \<button

                  key={item.id}

                  type="button"

                  onClick={() =\> runGeneration({ refineInstruction: item.instruction })}

                  className={\`${FOCUS} text-\[11px\] font-semibold bg-white hover:bg-emerald-600 hover:text-white text-emerald-800 border border-emerald-200 px-2.5 py-1 rounded-full transition-colors shadow-2xs\`}

                \>

                  + {item.label}

                \</button\>

              ))}

            \</div\>

            \<div className="flex items-center gap-1.5"\>

              \<input

                type="text"

                value={customRefineText}

                onChange={(e) =\> setCustomRefineText(e.target.value)}

                onKeyDown={(e) =\> {

                  if (e.key === 'Enter' && customRefineText.trim()) {

                    e.preventDefault();

                    const inst = customRefineText.trim();

                    setCustomRefineText('');

                    runGeneration({ refineInstruction: inst });

                  }

                }}

                placeholder="カスタム修正指示を入力（例：家族への声かけ例を3パターン追加して / 2ページ以内に要約して）"

                className={\`${FOCUS} flex-1 bg-white border border-emerald-200 rounded-lg px-2.5 py-1 text-xs\`}

              /\>

              \<button

                type="button"

                disabled={!customRefineText.trim()}

                onClick={() =\> {

                  const inst = customRefineText.trim();

                  if (!inst) return;

                  setCustomRefineText('');

                  runGeneration({ refineInstruction: inst });

                }}

                className={\`${FOCUS} px-3 py-1 bg-emerald-600 hover:bg-emerald-700 disabled:opacity-40 text-white rounded-lg text-xs font-bold whitespace-nowrap\`}

              \>

                反映する

              \</button\>

            \</div\>

          \</div\>

        )}

        {}

        {/\* メインプレビュー領域（A4用紙風コンテナ） \*/}

        \<div className="p-4 md:p-8 flex-1 overflow-y-auto max-h-\[820px\] bg-slate-200/60 rounded-b-2xl print:bg-white print:p-0 print:max-h-none"\>

          {outputHtml ? (

            viewMode === 'preview' ? (

              \<div className="max-w-\[210mm\] mx-auto bg-white shadow-md border border-slate-200 rounded-sm p-6 md:p-10 min-h-\[297mm\] print:shadow-none print:border-none print:p-0"\>

                {editing && (

                  \<div className="no-print mb-4 px-3 py-2 bg-amber-50 border border-amber-300 rounded-lg text-xs text-amber-900 flex items-center justify-between"\>

                    \<span\>

                      ✏️ \<strong\>直接編集モード中：\</strong\>文字や表のセルをクリックして直接書き換えられます。

                    \</span\>

                    \<button

                      type="button"

                      onClick={handleToggleEdit}

                      className="bg-amber-600 text-white font-bold px-2.5 py-1 rounded-md text-\[11px\]"

                    \>

                      編集完了

                    \</button\>

                  \</div\>

                )}

                \<div

                  ref={outputRef}

                  contentEditable={editing}

                  suppressContentEditableWarning

                  aria-label="生成された研修資料"

                  tabIndex={editing ? 0 : -1}

                  className={\`max-w-none focus:outline-none ${

                    editing ? 'ring-2 ring-amber-400/70 rounded p-2 -m-2 bg-amber-50/5' : ''

                  }\`}

                  dangerouslySetInnerHTML={{ \__html: outputHtml }}

                /\>

              \</div\>

            ) : (

              \<div className="max-w-4xl mx-auto bg-slate-900 text-slate-100 rounded-xl p-4 shadow-inner"\>

                \<div className="flex items-center justify-between pb-3 mb-3 border-b border-slate-700"\>

                  \<span className="text-xs font-bold text-emerald-400"\>

                    Word互換インラインHTMLソースコード（直接編集可能）

                  \</span\>

                  \<button

                    type="button"

                    onClick={handleCopyHtmlSource}

                    className="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 rounded text-xs font-bold text-slate-200 flex items-center gap-1"

                  \>

                    \<Copy className="w-3.5 h-3.5" aria-hidden="true" /\>

                    ソースをコピー

                  \</button\>

                \</div\>

                \<textarea

                  value={outputHtml}

                  onChange={(e) =\> setOutputHtml( sanitizeHtml(e.target.value) )}

                  className="w-full h-\[600px\] bg-slate-950 text-emerald-300 font-mono text-xs p-3 rounded-lg border border-slate-800 focus:outline-none"

                /\>

              \</div\>

            )

          ) : (

            \<div className="h-full min-h-\[540px\] max-w-xl mx-auto flex flex-col items-center justify-center text-center p-6"\>

              \<div className="w-16 h-16 rounded-2xl bg-white shadow-sm border border-slate-200 flex items-center justify-center mb-4 text-emerald-600"\>

                \<GraduationCap className="w-9 h-9" aria-hidden="true" /\>

              \</div\>

              \<h3 className="text-base font-bold text-slate-800"\>

                プロフェッショナルなケアマネ研修資料を即座に作成

              \</h3\>

              \<p className="text-xs text-slate-500 mt-2 leading-relaxed"\>

                左側のパネルから\<strong\>「1. 研修資料の形式」\</strong\>を選び、テーマや手元のメモを入力して\<strong\>「生成する」\</strong\>を押してください。Microsoft Wordへそのまま貼り付けても崩れないインライン表組レイアウトで出力されます。

              \</p\>

              \<div className="mt-6 flex flex-wrap justify-center gap-2"\>

                \<button

                  type="button"

                  onClick={() =\> {

                    const sample = SAMPLES\[formatId\] ?? SAMPLES.resume;

                    setTheme(sample.theme);

                    setSource(sample.source);

                    if (sample.duration) setMeta((m) =\> ({ ...m, duration: sample.duration }));

                    if (sample.instructor) setMeta((m) =\> ({ ...m, instructor: sample.instructor }));

                    showToast(\`「${selectedFormat.title}」のサンプルをセットしました\`);

                  }}

                  className={\`${FOCUS} px-4 py-2.5 rounded-xl bg-white hover:bg-emerald-50 text-emerald-700 border border-emerald-300 text-xs font-bold shadow-xs flex items-center gap-1.5 transition-colors\`}

                \>

                  \<Sparkles className="w-4 h-4" aria-hidden="true" /\>

                  \<span\>1. サンプルデータを自動入力する\</span\>

                \</button\>

                \<button

                  type="button"

                  onClick={() =\> {

                    const sample = SAMPLES\[formatId\] ?? SAMPLES.resume;

                    const nextTheme = theme.trim() || sample.theme;

                    const nextSource = source.trim() || sample.source;

                    setTheme(nextTheme);

                    setSource(nextSource);

                    const instantHtml = buildLocalStructuredDocument({

                      formatId,

                      styleId,

                      colorThemeId,

                      theme: nextTheme,

                      source: nextSource,

                      meta,

                    });

                    updateOutputWithHistory(instantHtml, true, nextTheme);

                    showToast('サンプルから即座にプレビューを生成しました');

                  }}

                  className={\`${FOCUS} px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-xs flex items-center gap-1.5 transition-colors\`}

                \>

                  \<Wand2 className="w-4 h-4" aria-hidden="true" /\>

                  \<span\>2. ワンクリックで完成見本を表示\</span\>

                \</button\>

              \</div\>

            \</div\>

          )}

        \</div\>

      \</section\>

    \</div\>

  \</main\>

  {}

  {/\* 生成履歴ドロワー \*/}

  {showHistoryDrawer && (

    \<div className="no-print fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs flex justify-end"\>

      \<div className="w-full max-w-md bg-white h-full shadow-2xl border-l border-slate-200 flex flex-col"\>

        \<div className="p-4 border-b border-slate-200 flex items-center justify-between"\>

          \<div className="flex items-center gap-2"\>

            \<History className="w-5 h-5 text-emerald-600" aria-hidden="true" /\>

            \<h3 className="font-bold text-sm text-slate-900"\>作成した研修資料の履歴（最大15件）\</h3\>

          \</div\>

          \<button

            type="button"

            onClick={() =\> setShowHistoryDrawer(false)}

            className="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100"

          \>

            \<X className="w-4 h-4" /\>

          \</button\>

        \</div\>

        \<div className="flex-1 overflow-y-auto p-4 space-y-2.5"\>

          {history.length === 0 ? (

            \<p className="text-xs text-slate-400 text-center py-12"\>まだ生成履歴がありません。\</p\>

          ) : (

            history.map((item) =\> (

              \<div

                key={item.id}

                onClick={() =\> {

                  setFormatId(item.formatId);

                  if (item.styleId) setStyleId(item.styleId);

                  if (item.colorThemeId) setColorThemeId(item.colorThemeId);

                  setTheme(item.theme);

                  setOutputHtml(item.html);

                  setShowHistoryDrawer(false);

                  showToast('履歴から資料を復元しました');

                }}

                className="p-3 rounded-xl border border-slate-200 hover:border-emerald-500 hover:bg-emerald-50/30 cursor-pointer transition-all group"

              \>

                \<div className="flex items-center justify-between gap-2"\>

                  \<span className="text-\[11px\] font-bold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800"\>

                    {item.formatTitle}

                  \</span\>

                  \<div className="flex items-center gap-2"\>

                    \<span className="text-\[11px\] text-slate-400 flex items-center gap-1"\>

                      \<Clock className="w-3 h-3" /\> {item.createdAt}

                    \</span\>

                    \<button

                      type="button"

                      onClick={(e) =\> handleDeleteHistoryItem(item.id, e)}

                      className="text-slate-300 hover:text-rose-600 p-1"

                      title="履歴から削除"

                    \>

                      \<Trash2 className="w-3.5 h-3.5" /\>

                    \</button\>

                  \</div\>

                \</div\>

                \<p className="text-xs font-bold text-slate-800 mt-1.5 line-clamp-2"\>{item.theme}\</p\>

              \</div\>

            ))

          )}

        \</div\>

      \</div\>

    \</div\>

  )}

  {/\* API設定モーダル \*/}

  {showSettingsModal && (

    \<div className="no-print fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4"\>

      \<div className="bg-white rounded-2xl max-w-md w-full p-5 shadow-xl border border-slate-200 space-y-4"\>

        \<div className="flex items-center justify-between"\>

          \<h3 className="font-bold text-sm text-slate-900 flex items-center gap-2"\>

            \<Sliders className="w-4 h-4 text-emerald-600" /\>

            API接続・動作環境設定

          \</h3\>

          \<button

            type="button"

            onClick={() =\> setShowSettingsModal(false)}

            className="p-1 text-slate-400 hover:text-slate-700 rounded-lg"

          \>

            \<X className="w-4 h-4" /\>

          \</button\>

        \</div\>

        \<p className="text-xs text-slate-600 leading-relaxed"\>

          Canvas環境では空欄のままで自動認証されます。ローカル環境や外部サーバーで独自のGemini APIキーを使用する場合のみ以下に入力してください。

        \</p\>

        \<div\>

          \<label htmlFor="custom-api-key" className="block text-xs font-bold text-slate-700 mb-1"\>

            Google Gemini API Key（任意）

          \</label\>

          \<input

            id="custom-api-key"

            type="password"

            value={customApiKey}

            onChange={(e) =\> setCustomApiKey(e.target.value)}

            placeholder="AIzaSy..."

            className={\`${FOCUS} w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs font-mono\`}

          /\>

        \</div\>

        \<div className="flex justify-end gap-2 pt-2"\>

          \<button

            type="button"

            onClick={() =\> setShowSettingsModal(false)}

            className="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl"

          \>

            設定を保存して閉じる

          \</button\>

        \</div\>

      \</div\>

    \</div\>

  )}

  {/\* トースト通知 \*/}

  \<div aria-live="polite" className="no-print fixed bottom-5 left-1/2 -translate-x-1/2 z-50 pointer-events-none"\>

    {toast && (

      \<div className="bg-slate-900 text-white text-xs font-bold px-4 py-2.5 rounded-full shadow-xl flex items-center gap-2 border border-slate-700"\>

        \<Check className="w-4 h-4 text-emerald-400 shrink-0" aria-hidden="true" /\>

        \<span\>{toast}\</span\>

      \</div\>

    )}

  \</div\>

\</div\>

);

}
