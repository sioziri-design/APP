class ApiError extends Error {

constructor(message, status) {

super(message);

this.name = 'ApiError';

this.status = status;

}

}

async function callGemini({ modelId, system, user, signal, customApiKey }) {

const activeKey = customApiKey?.trim() || DEFAULT_API_KEY;

const url = `${API_BASE}/${modelId}:generateContent${activeKey ? `?key=${encodeURIComponent(activeKey)}` : ''}`;

const res = await fetch(url, {

method: 'POST',

headers: { 'Content-Type': 'application/json' },

signal,

body: JSON.stringify({

  contents: \[{ role: 'user', parts: \[{ text: user }\] }\],

  systemInstruction: { parts: \[{ text: system }\] },

  generationConfig: { temperature: 0.3 },

}),

});

if (!res.ok) {

const err = await res.json().catch(() =\> ({}));

throw new ApiError(err.error?.message || \`API通信エラーが発生しました (HTTP ${res.status})\`, res.status);

}

const data = await res.json();

const blockReason = data.promptFeedback?.blockReason;

if (blockReason) {

throw new ApiError(\`入力内容が安全フィルターにより制限されました（理由: ${blockReason}）。表現を調整してお試しください。\`);

}

const text = (data.candidates?.[0]?.content?.parts ?? []).map((p) => p.text ?? '').join('');

if (!text.trim()) throw new ApiError('AIからの応答が空でした。もう一度お試しください。');

return text;

}

const stripCodeFence = (raw) => {

const fenced = raw.match(/```(?:html)?\s*([\s\S]*?)```/i);

return (fenced ? fenced[1] : raw.replace(/^```(?:html)?\s*/i, '').replace(/```\s*$/i, '')).trim();

};

const BLOCKED_TAGS = 'script,style,iframe,object,embed,link,meta,base,form,input,button,textarea,select,svg,math';

const sanitizeHtml = (html) => {

const doc = new DOMParser().parseFromString(html, 'text/html');

doc.querySelectorAll(BLOCKED_TAGS).forEach((n) => n.remove());

doc.body.querySelectorAll('*').forEach((el) => {

\[...el.attributes\].forEach(({ name, value }) =\> {

  const n = name.toLowerCase();

  const unsafeUrl = \['href', 'src', 'xlink:href'\].includes(n) && /^\\s\*(javascript|data|vbscript):/i.test(value);

  if (n.startsWith('on') || unsafeUrl) el.removeAttribute(name);

});

});

return doc.body.innerHTML;

};

