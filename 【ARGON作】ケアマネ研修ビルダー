const handleExportPdf = async () => {

const html = getLatestHtml();

if (!html) return;

setBusy(true);

setStatus('高解像度A4 PDFを生成中...');

try {

  const html2pdf = await loadHtml2Pdf();

  const el = document.createElement('div');

  el.style.padding = '8px';

  el.style.backgroundColor = '#ffffff';

  el.innerHTML = html;

  await html2pdf()

    .set({

      margin: \[12, 12, 12, 12\],

      filename: safeFileName(\`ケアマネ研修資料\_${formatTitle}\_${today()}.pdf\`),

      image: { type: 'jpeg', quality: 0.98 },

      html2canvas: { scale: 2, useCORS: true, letterRendering: true, scrollY: 0, windowY: 0 },

      jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },

      pagebreak: { mode: \['css', 'legacy'\], avoid: \['tr', 'h1', 'h2', 'h3'\] },

    })

    .from(el)

    .save();

  showToast('PDFファイルを出力しました');

} catch (err) {

  console.error(err);

  setError(err.message || 'PDFの出力中にエラーが発生しました。「印刷 / PDF」ボタンもご利用いただけます。');

} finally {

  setBusy(false);

  setStatus('');

}

};

