<div>

<div className="flex items-center justify-between mb-1.5">

<label className="text-xs font-bold text-slate-700 flex items-center gap-1.5"><Paperclip className="w-3.5 h-3.5 text-blue-700" /> 4. 参照記録データ<span className="text-[10px] font-normal text-slate-400">({sourceText.length} 文字)</span></label>

<button onClick={() => fileInputRef.current?.click()} className="text-[11px] font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 px-2.5 py-1 rounded-lg transition-colors flex items-center gap-1 border border-slate-200"><FileUp className="w-3.5 h-3.5 text-blue-700" /> テキスト読込</button>

<input type="file" ref={fileInputRef} onChange={handleFileUpload} accept=".txt,.md,.csv,.json" className="hidden" />

</div>

<textarea value={sourceText} onChange={(e) => setSourceText(e.target.value)} placeholder="現場でとった手書きメモ、日々の介護記録テキスト、音声文字起こしデータなどをそのまま貼り付け..." className="w-full h-36 p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all resize-y leading-relaxed" />

</div>

{errorMsg && (

<div className="p-3 bg-rose-50 border border-rose-200 text-rose-700 rounded-xl text-xs flex items-start gap-2 leading-relaxed">

<AlertCircle className="w-4 h-4 shrink-0 mt-0.5" /><span>{errorMsg}</span>

</div>

)}

<button onClick={handleGenerate} disabled={isGenerating} className={`w-full py-3.5 px-4 rounded-xl font-bold text-sm text-white shadow-md flex items-center justify-center gap-2 transition-all mt-auto ${isGenerating ? 'bg-slate-400 cursor-not-allowed' : 'bg-gradient-to-r from-blue-700 to-sky-600 hover:from-blue-800 hover:to-sky-700 hover:shadow-lg active:scale-[0.99]'}`}>

{isGenerating ? <><RefreshCw className="w-4 h-4 animate-spin" /><span>ドキュメント構造化・生成中...</span></> : <><Sparkles className="w-4 h-4" /><span>「{currentFormatObj.title.replace(/^[0-9\.\s]+/, '')}」を生成する</span></>}

</button>

{statusMsg && <div className="text-center text-[11px] font-semibold text-blue-800 bg-blue-50 p-2 rounded-lg animate-pulse border border-blue-200">{statusMsg}</div>}

</div>

</div>

<div className="lg:col-span-7 flex flex-col lg:h-[calc(100vh-115px)] min-h-[640px]">

<div className="bg-white rounded-2xl shadow-sm border border-slate-200 flex flex-col h-full overflow-hidden">

<div className="p-3 border-b border-slate-200 flex flex-wrap items-center justify-between gap-2 bg-slate-50/90">

<div className="flex items-center gap-1.5 flex-wrap">

<div className="flex items-center bg-slate-200/80 p-0.5 rounded-lg border border-slate-300/60">

<button onClick={() => setViewMode('preview')} className={`px-2.5 py-1 rounded-md text-xs font-bold flex items-center gap-1 transition-all ${viewMode === 'preview' ? 'bg-white text-blue-800 shadow-sm' : 'text-slate-600 hover:text-slate-900'}`}><Eye className="w-3.5 h-3.5" /> A4プレビュー</button>

<button onClick={() => { if (isEditing && outputRef.current) { setOutputHtml(outputRef.current.innerHTML); setIsEditing(false); } setViewMode('html'); }} className={`px-2.5 py-1 rounded-md text-xs font-bold flex items-center gap-1 transition-all ${viewMode === 'html' ? 'bg-white text-blue-800 shadow-sm' : 'text-slate-600 hover:text-slate-900'}`}><Code className="w-3.5 h-3.5" /> HTMLソース</button>

</div>

{outputHtml && viewMode === 'preview' && (

<div className="hidden sm:flex items-center gap-1 bg-white border border-slate-200 rounded-lg px-1.5 py-0.5 text-xs">

<button onClick={() => setZoomLevel(z => Math.max(70, z - 10))} className="p-1 text-slate-500 hover:text-slate-800"><ZoomOut className="w-3.5 h-3.5" /></button>

<span className="text-[11px] font-bold text-slate-600 min-w-[36px] text-center">{zoomLevel}%</span>

<button onClick={() => setZoomLevel(z => Math.min(130, z + 10))} className="p-1 text-slate-500 hover:text-slate-800"><ZoomIn className="w-3.5 h-3.5" /></button>

{zoomLevel !== 100 && <button onClick={() => setZoomLevel(100)} className="p-1 text-slate-400 hover:text-slate-700"><RotateCcw className="w-3 h-3" /></button>}

</div>

)}

{outputHtml && viewMode === 'preview' && (

<button onClick={handleToggleEdit} className={`text-xs px-2.5 py-1.5 rounded-lg font-bold border transition-all flex items-center gap-1.5 ${isEditing ? 'bg-amber-500 border-amber-600 text-white shadow-sm' : 'bg-white border-slate-300 text-slate-700 hover:bg-slate-100 shadow-sm'}`}><Edit3 className="w-3.5 h-3.5" /><span>{isEditing ? '編集を確定' : '文字を直接編集'}</span></button>

)}

</div>

{outputHtml && (

<div className="flex items-center gap-1.5 flex-wrap">

<button onClick={handleCopyClipboard} className="bg-white hover:bg-slate-100 border border-slate-300 text-slate-700 px-2.5 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1 shadow-sm transition-all">{copySuccess ? <Check className="w-3.5 h-3.5 text-emerald-600" /> : <Copy className="w-3.5 h-3.5 text-blue-700" />}<span>{copySuccess ? 'コピー済' : '書式コピー'}</span></button>

<button onClick={handleExportWord} className="bg-blue-700 hover:bg-blue-800 border border-blue-800 text-white px-3 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1 shadow-sm transition-all"><Download className="w-3.5 h-3.5" /><span>Word保存</span></button>

<button onClick={handleExportPdf} className="bg-slate-800 hover:bg-slate-900 border border-slate-900 text-white px-2.5 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1 shadow-sm transition-all"><FileDown className="w-3.5 h-3.5" /><span>PDF出力</span></button>

<button onClick={handlePrint} className="bg-white hover:bg-slate-100 border border-slate-300 text-slate-700 p-1.5 rounded-lg text-xs font-bold shadow-sm transition-all hidden sm:flex items-center" title="印刷する"><Printer className="w-3.5 h-3.5" /></button>

</div>

)}

</div>

{isEditing && viewMode === 'preview' && (

<div className="bg-amber-50 border-b border-amber-200 px-4 py-1.5 text-[11px] font-bold text-amber-900 flex items-center justify-between">

<span>✏️ 直接編集モード中：用紙内のテキストや表の数値をクリックして直接書き換えられます。</span>

<button onClick={handleToggleEdit} className="bg-amber-600 text-white px-2 py-0.5 rounded font-bold hover:bg-amber-700">編集完了して保存</button>

</div>

)}

<div className="flex-1 overflow-y-auto p-4 md:p-6 bg-slate-200/70 stylish-scrollbar">

{outputHtml ? (

viewMode === 'preview' ? (

<div style={{ transform: `scale(${zoomLevel / 100})`, transformOrigin: 'top center', transition: 'transform 0.15s ease-out' }} className="max-w-[210mm] mx-auto bg-white min-h-[297mm] shadow-md border border-slate-300 rounded-sm print-sheet">

<div ref={outputRef} contentEditable={isEditing} suppressContentEditableWarning={true} onBlur={() => { if (isEditing && outputRef.current) setOutputHtml(outputRef.current.innerHTML); }} className={`p-6 md:p-10 focus:outline-none transition-colors ${isEditing ? 'bg-amber-50/20 ring-2 ring-amber-400/60 min-h-[297mm]' : ''}`} dangerouslySetInnerHTML={{ __html: outputHtml }} />

</div>

) : (

<div className="max-w-4xl mx-auto bg-slate-900 text-slate-100 rounded-xl p-4 shadow-inner border border-slate-700 h-full flex flex-col">

<div className="flex items-center justify-between pb-2 mb-2 border-b border-slate-700 text-xs text-slate-400"><span>Word互換 インラインCSS付きHTMLソースコード（直接編集可）</span><span className="font-mono">{outputHtml.length} chars</span></div>

<textarea value={outputHtml} onChange={(e) => setOutputHtml(e.target.value)} className="w-full flex-1 bg-transparent font-mono text-xs text-emerald-300 focus:outline-none resize-none leading-relaxed" />

</div>

)

) : (

<div className="max-w-[210mm] mx-auto bg-white min-h-[520px] h-full shadow-sm border border-slate-200 rounded-xl flex flex-col items-center justify-center text-center p-8">

<div className="w-16 h-16 bg-blue-50 rounded-2xl flex items-center justify-center mb-4 border border-blue-100"><LayoutTemplate className="w-8 h-8 text-blue-600 stroke-[1.75]" /></div>

<h3 className="text-base font-bold text-slate-800 mb-1.5">A4 Word互換ドキュメント プレビュー</h3>

<p className="text-xs text-slate-500 max-w-md leading-relaxed mb-6">左側のパネルで「1. ドキュメント形式」と「2. 文体ターゲット」を選び、記録メモを入力して生成ボタンを押してください。</p>

<div className="w-full max-w-lg bg-slate-50 border border-slate-200 rounded-xl p-4 text-left">

<div className="text-xs font-bold text-slate-700 mb-2.5 flex items-center gap-1.5"><Sparkles className="w-4 h-4 text-blue-700" /> 1クリックで試せるクイックスタート</div>

<div className="grid grid-cols-1 sm:grid-cols-2 gap-2">

{['raw_table', 'soap', 'conference', 'medical_link'].map(fid => {

const fObj = FORMATS.find(f => f.id === fid);

if (!fObj) return null;

return (

<button key={fid} onClick={() => { setSelectedFormat(fid); const smp = SAMPLES[fid]; setInputText(smp.request); setSourceText(smp.source); showToast(`「${fObj.title}」のサンプルをセットしました`); }} className="p-2.5 bg-white hover:bg-blue-50/60 rounded-lg border border-slate-200 hover:border-blue-400 text-left transition-all flex items-center justify-between group">

<div className="min-w-0 pr-2"><div className="text-xs font-bold text-slate-800 group-hover:text-blue-800 truncate">{fObj.title}</div><div className="text-[10px] text-slate-400 truncate mt-0.5">サンプルデータを自動入力</div></div>

<ChevronRight className="w-4 h-4 text-slate-300 group-hover:text-blue-600 shrink-0" />

</button>

);

})}

</div>

</div>

</div>

)}

</div>

</div>

</div>

</main>

</div>

);

}

const root = ReactDOM.createRoot(document.getElementById('root'));

root.render(<App />);

</script>

</body>

</html>
