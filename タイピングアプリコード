const DEFAULT_SETTINGS = { profile: 'standard', level: 'standard', sectionLen: 200, fontSize: 'standard', sound: true, volume: 0.5 };
const slimResult = (r) => ({ ...r, sections: r.sections.map(({ segs, ...s }) => s), blocks: r.blocks.slice(0, 60) });

export default function App() {
  const [settings, setSettingsRaw] = useState(() => ({ ...DEFAULT_SETTINGS, ...store.get('tf_settings', {}) }));
  const [library, setLibrary] = useState(() => store.get('tf_library', []));
  const [history, setHistory] = useState(() => store.get('tf_history', []));
  const [material, setMaterial] = useState(null);
  const [mode, setMode] = useState('t180');
  const [view, setView] = useState('home');
  const [result, setResult] = useState(null);
  const [sessionKey, setSessionKey] = useState(0);
  const [modal, setModal] = useState('');
  const [toasts, setToasts] = useState([]);

  const setSettings = (s) => { setSettingsRaw(s); store.set('tf_settings', s); };
  useEffect(() => { store.set('tf_library', library); }, [library]);
  const toast = (msg, kind = 'info') => { const id = uid(); setToasts((t) => [...t, { id, msg, kind }]); setTimeout(() => setToasts((t) => t.filter((x) => x.id !== id)), 3200); };

  const start = () => { if (!material) return; setSessionKey((k) => k + 1); setView('typing'); };
  const onFinish = (res) => {
    const slim = slimResult(res);
    setResult(slim); setView('result');
    setHistory((h) => { const n = [slim, ...h].slice(0, 100); store.set('tf_history', n); return n; });
  };
  const onDrill = (m) => {
    const full = { id: uid(), createdAt: new Date().toISOString(), ...m };
    setMaterial(full); setLibrary((lib) => [full, ...lib].slice(0, 40)); setSessionKey((k) => k + 1); setView('typing'); toast('苦手克服の教材を作成しました', 'ok');
  };
  const resetAll = () => { ['tf_settings', 'tf_library', 'tf_history'].forEach(store.del); setSettingsRaw(DEFAULT_SETTINGS); setLibrary([]); setHistory([]); setMaterial(null); setView('home'); toast('保存データを削除しました', 'info'); };

  return (
    <div className="tf-root">
      <style>{CSS}</style>
      <header className="sticky top-0 z-30 print:hidden" style={{ background: 'rgba(13,17,22,.92)', backdropFilter: 'blur(8px)', borderBottom: '1px solid var(--ln)' }}>
        <div className="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between">
          <button className="flex items-center gap-2.5" onClick={() => view !== 'typing' && setView('home')} aria-label="ホームへ">
            <span className="tf-serif font-black text-lg w-8 h-8 rounded-md flex items-center justify-center" style={{ background: 'var(--paper)', color: 'var(--ink)' }}>打</span>
            <span className="text-left leading-tight"><span className="block font-bold text-[15px]">TypingForge</span><span className="block text-[10.5px] c-mu">変換後の文字で判定する日本語タイピング</span></span>
          </button>
          <nav className="flex items-center gap-1.5" aria-label="メインメニュー">
            <button className="tf-btn" onClick={() => setModal('history')}><Ic n="hist" s={15} /><span className="hidden sm:inline">履歴</span></button>
            <button className="tf-btn" onClick={() => setModal('method')}><Ic n="info" s={15} /><span className="hidden sm:inline">判定基準</span></button>
            <button className="tf-btn" onClick={() => setModal('settings')}><Ic n="gear" s={15} /><span className="hidden sm:inline">設定</span></button>
          </nav>
        </div>
      </header>

      <main>
        {view === 'home' && <HomeView material={material} setMaterial={setMaterial} library={library} setLibrary={setLibrary} mode={mode} setMode={setMode} settings={settings} setSettings={setSettings} onStart={start} toast={toast} onOpenMethod={() => setModal('method')} history={history} />}
        {view === 'typing' && material && <TypingSession key={sessionKey} material={material} mode={mode} settings={settings} onFinish={onFinish} onAbort={() => setView('home')} toast={toast} />}
        {view === 'result' && result && <ResultView key={result.id} result={result} history={history} settings={settings} onRetry={start} onHome={() => setView('home')} onDrill={onDrill} toast={toast} onOpenMethod={() => setModal('method')} />}
      </main>

      <HistoryModal open={modal === 'history'} onClose={() => setModal('')} history={history} onSelect={(h) => { setResult(h); setView('result'); }} onClear={() => { store.del('tf_history'); setHistory([]); }} />
      <MethodModal open={modal === 'method'} onClose={() => setModal('')} profile={settings.profile} />
      <SettingsModal open={modal === 'settings'} onClose={() => setModal('')} settings={settings} setSettings={setSettings} onResetAll={resetAll} />

      <div className="fixed top-16 left-1/2 -translate-x-1/2 z-[60] flex flex-col gap-2 items-center pointer-events-none" aria-live="polite">
        {toasts.map((t) => (<div key={t.id} className="tf-card px-4 py-2.5 text-sm tf-pop shadow-xl" style={{ borderColor: t.kind === 'error' ? 'var(--sh)' : t.kind === 'ok' ? 'var(--gr)' : 'var(--ln)' }}>{t.msg}</div>))}
      </div>
    </div>
  );
}
