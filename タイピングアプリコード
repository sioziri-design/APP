    '口調は丁寧で前向き。具体的で、今日から実行できる練習を提示する。',
  ].join('\n');
  const topBlocks = result.blocks.slice(0, 25).map((b) => ({ 区間: b.section, 正解: b.target || '（なし）', 入力: b.input || '（なし）', 種別: b.kind, 前後: `${b.before}[ ]${b.after}` }));
  const data = {
    正味速度_文字毎分: result.speed.netCpm, 粗速度_文字毎分: result.speed.grossCpm,
    正確率: result.totals.accuracy, 誤字: result.totals.sub, 脱字: result.totals.miss, 余字: result.totals.extra,
    評価対象文字数: result.totals.evalLen, 計測秒: result.timing.sec,
    速度ランク: result.rank.id, 次ランクまで文字毎分: result.rank.toNext,
    文字種別正確率: Object.fromEntries(Object.entries(result.classes).map(([k, v]) => [CLASS_LABEL[k], v.acc])),
    ペース安定度: result.stability, 持続率: result.stamina,
    誤りの種別件数: result.typeCounts, 誤りの詳細: topBlocks,
  };
  return callGemini({
    system, temperature: 0.6, signal, maxTokens: 4096,
    parts: [{ text: '次の測定結果を分析し、コーチングしてください。\n' + JSON.stringify(data) }],
    schema: {
