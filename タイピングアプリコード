        <div className="tf-card2 p-3"><div className="tf-h">最高 正味速度</div><div className="tf-mono text-xl font-bold c-gd">{best || '—'}</div></div>
        <div className="tf-card2 p-3"><div className="tf-h">平均 正確率</div><div className="tf-mono text-xl font-bold c-gr">{avgAcc}{history.length ? '%' : ''}</div></div>
      </div>
      {trend.length >= 2 && <div className="mb-4"><div className="tf-h mb-1">正味速度の推移（字/分・古い順）</div><LineChart data={trend} xKey="t" color="#d8b45e" yLabel="正味速度" /></div>}
      {history.length === 0 ? <div className="c-mu text-sm text-center py-10">まだ記録がありません。</div> : (
        <div className="overflow-x-auto tf-scroll max-h-[46vh]"><table className="tf-table"><thead><tr><th>教材</th><th>モード</th><th>ランク</th><th>正味速度</th><th>正確率</th><th>スコア</th><th>区分</th><th>日時</th></tr></thead>
          <tbody className="tf-mono">{history.map((h) => (
            <tr key={h.id} className="cursor-pointer hover:bg-[var(--p2)]" onClick={() => { onSelect(h); onClose(); }}>
              <td className="!font-sans max-w-[200px] truncate">{h.title}</td><td className="!font-sans">{MODES[h.mode]?.label}</td>
              <td className="font-bold" style={{ color: RANK_COLOR[h.rank.id] }}>{h.rank.id}</td><td>{h.speed.netCpm}</td><td>{h.totals.accuracy}%</td><td>{h.score.total}</td>
              <td className={`!font-sans ${h.reliability.certified ? 'c-gr' : 'c-gd'}`}>{h.reliability.certified ? '認定' : '参考'}</td><td className="c-mu">{fmtDate(h.at)}</td></tr>))}</tbody></table></div>
      )}
      {history.length > 0 && <div className="mt-4 flex justify-end">{confirm ? <div className="flex items-center gap-2 text-sm"><span className="c-sh">全履歴を削除しますか？</span><button className="tf-btn" onClick={() => { onClear(); setConfirm(false); }}>削除する</button><button className="tf-btn" onClick={() => setConfirm(false)}>やめる</button></div> : <button className="tf-btn" onClick={() => setConfirm(true)}><Ic n="trash" s={14} />履歴を削除</button>}</div>}
    </Modal>
  );
}

function MethodModal({ open, onClose, profile }) {
