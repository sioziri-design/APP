/**
 * TypingForge ― 変換後の日本語文字で判定するタイピング検定アプリ（Gemini Canvas用・単一ファイル）
 *
 * ・APIキー不要：AI機能（教材生成／PDF文字起こし／整形／コーチ）はCanvas上のGemini Flashを使用
 * ・正誤は「IMEで確定した日本語の文字」を編集距離で照合（ローマ字は不使用）
 * ・正誤・速度・ランク・スコアの計算にAIは関与しない（すべて決定的な数式）
 * ・デフォルト教材なし（走れメロス等は含まない）
 */
import React, { useState, useEffect, useRef, useMemo } from 'react';

/* ============================================================================
   ENGINE : 判定エンジン（UI非依存の純粋関数。単体テスト済み）
   ----------------------------------------------------------------------------
   ■ 判定の大原則
   1. 正誤は「IMEで変換・確定された日本語の文字」を 1文字（書記素）単位で照合する。
      ローマ字の打鍵列は一切使わない。
   2. 照合は編集距離(Levenshtein)による最適アライメント。誤字/脱字/余字を厳密に分類。
   3. 速度は「正解文字数 ÷ 計測時間」。誤字入力は速度に加算されない（正味速度）。
   4. 確定前（変換中）の文字は計測に含めない。Backspaceによる訂正は時間として反映される。
   5. 表示するすべての数値は実測値から算出。固定値・乱数・見せかけの指標は一切使わない。
   ========================================================================== */

const _SEG = (typeof Intl !== 'undefined' && Intl.Segmenter) ? new Intl.Segmenter('ja', { granularity: 'grapheme' }) : null;
const toG = (s) => (!s ? [] : _SEG ? Array.from(_SEG.segment(s), (x) => x.segment) : Array.from(s));

const MATCH_LEVELS = {
  strict:   { label: '厳密',     desc: '改行のみ無視。空白・全角/半角・記号を含め完全一致を要求' },
  standard: { label: '標準',     desc: '空白・改行の差を無視。それ以外（全角/半角・記号・漢字）は完全一致を要求' },
  lenient:  { label: '寛容',     desc: '標準に加え、全角/半角・互換文字の違い（例: １と1、ｱとア）を同一視' },
};

function normalizeForJudge(s, level = 'standard') {
  let t = (s ?? '').normalize('NFC').replace(/[\u200B-\u200D\uFEFF]/g, '').replace(/\r\n?/g, '\n');
  if (level === 'lenient') t = t.normalize('NFKC');
  t = level === 'strict' ? t.replace(/\n/g, '') : t.replace(/[\s\u3000]+/g, '');
  return t;
}

/* ---- 文字種 ---- */
const RE_HIRA = /[\u3041-\u3096\u309D\u309E]/;
const RE_KATA = /[\u30A1-\u30FA\u30FC\u30FD\u30FE\uFF66-\uFF9F]/;
const RE_KANJI = /[\u3400-\u4DBF\u4E00-\u9FFF\u3005\u3006\u3007\uF900-\uFAFF]/;
const RE_ALNUM = /[A-Za-z0-9\uFF21-\uFF3A\uFF41-\uFF5A\uFF10-\uFF19]/;
const CLASS_LABEL = { hira: 'ひらがな', kata: 'カタカナ', kanji: '漢字', alnum: '英数字', sym: '句読点・記号' };
function classOf(ch) {
  if (RE_HIRA.test(ch)) return 'hira';
  if (RE_KATA.test(ch)) return 'kata';
  if (RE_KANJI.test(ch)) return 'kanji';
  if (RE_ALNUM.test(ch)) return 'alnum';
  return 'sym';
}
const toHira = (s) => s.replace(/[\u30A1-\u30F6]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0x60));

/* ---- 最適アライメント ---- */
function alignGraphemes(tArr, iArr, partial) {
  const m = tArr.length, n = iArr.length, W = n + 1;
  const dp = new Uint32Array((m + 1) * W);
  for (let j = 0; j <= n; j++) dp[j] = j;
  for (let i = 0; i <= m; i++) dp[i * W] = i;
  for (let i = 1; i <= m; i++) {
    const ti = tArr[i - 1];
    for (let j = 1; j <= n; j++) {
      const c = ti === iArr[j - 1] ? 0 : 1;
      const a = dp[(i - 1) * W + j - 1] + c, b = dp[(i - 1) * W + j] + 1, d = dp[i * W + j - 1] + 1;
      dp[i * W + j] = a < b ? (a < d ? a : d) : (b < d ? b : d);
    }
  }
  // 途中までの入力(partial)は「未到達の末尾」を評価対象から外す（最小距離となる到達点を採用）
  let end = m;
  if (partial) {
    let best = Infinity;
    for (let i = 0; i <= m; i++) { const v = dp[i * W + n]; if (v <= best) { best = v; end = i; } }
  }
  const segs = [];
  let i = end, j = n;
  while (i > 0 || j > 0) {
    const cur = dp[i * W + j];
    if (i > 0 && j > 0 && tArr[i - 1] === iArr[j - 1] && cur === dp[(i - 1) * W + j - 1]) {
      segs.push({ k: 'ok', a: tArr[i - 1], b: iArr[j - 1], ti: i - 1 }); i--; j--;
    } else if (i > 0 && j > 0 && cur === dp[(i - 1) * W + j - 1] + 1) {
      segs.push({ k: 'sub', a: tArr[i - 1], b: iArr[j - 1], ti: i - 1 }); i--; j--;
    } else if (i > 0 && cur === dp[(i - 1) * W + j] + 1) {
      segs.push({ k: 'miss', a: tArr[i - 1], b: '', ti: i - 1 }); i--;
    } else {
      segs.push({ k: 'extra', a: '', b: iArr[j - 1], ti: i }); j--;
    }
  }
  segs.reverse();
  let ok = 0, sub = 0, miss = 0, extra = 0;
  for (const s of segs) { if (s.k === 'ok') ok++; else if (s.k === 'sub') sub++; else if (s.k === 'miss') miss++; else extra++; }
  return { segs, evalLen: end, inputLen: n, ok, sub, miss, extra, dist: sub + miss + extra };
}

/* ---- 誤りの種類を判定（実際の文字の組み合わせから機械的に分類） ---- */
function classifyBlock(t, i) {
  if (!t) return '余字（余分な文字）';
  if (!i) return '脱字（入力漏れ）';
  if (t.normalize('NFKC') === i.normalize('NFKC')) return '全角・半角の違い';
  const tc = toG(t).map(classOf), ic = toG(i).map(classOf);
  const all = (arr, c) => arr.every((x) => x === c);
  if (all(tc, 'sym') && all(ic, 'sym')) return '句読点・記号の違い';
  const kana = (x) => x === 'hira' || x === 'kata';
  if (tc.includes('kanji') && ic.every(kana)) return '未変換（かなのまま）';
  if (tc.includes('kanji') && ic.includes('kanji')) return '異なる漢字（誤変換・同音異義）';
  if (tc.every(kana) && ic.includes('kanji')) return '過剰変換（かなを漢字に）';
  if (tc.every(kana) && ic.every(kana)) return toHira(t) === toHira(i) ? 'ひらがな/カタカナの違い' : 'かなの打ち間違い';
  if (tc.includes('alnum') || ic.includes('alnum')) return '英数字の違い';
  return '文字の違い';
}

function buildBlocks(segs, tArr) {
  const blocks = [];
  let cur = null;
  const flush = () => {
    if (!cur) return;
    cur.kind = classifyBlock(cur.target, cur.input);
    cur.before = tArr.slice(Math.max(0, cur.at - 4), cur.at).join('');
    const after = cur.at + toG(cur.target).length;
    cur.after = tArr.slice(after, after + 4).join('');
    blocks.push(cur); cur = null;
  };
  for (const s of segs) {
    if (s.k === 'ok') { flush(); continue; }
    if (!cur) cur = { at: s.ti, target: '', input: '' };
    cur.target += s.a; cur.input += s.b;
  }
  flush();
  return blocks;
}

/* ---- 日本語ローマ字換算（推定。他アプリとの比較目安としてのみ表示） ---- */
function estimateKeys(str) {
  let k = 0;
  for (const ch of toG(str)) {
    const c = classOf(ch);
    k += c === 'hira' ? 1.9 : c === 'kata' ? (ch === 'ー' ? 1 : 2.0) : c === 'kanji' ? 3.9 : 1;
  }
  return k;
}
const REF_KEYS_PER_CHAR = 2.6;

/* ---- ランク体系（正味速度 = 変換後の正解文字数 / 分） ---- */
const LADDER = [
  { id: 'D',   min: 0,   name: '入門' },
  { id: 'C',   min: 30,  name: '初級' },
  { id: 'B',   min: 55,  name: '中級' },
  { id: 'A',   min: 80,  name: '上級' },
  { id: 'A+',  min: 105, name: '上級＋' },
  { id: 'S',   min: 130, name: 'エキスパート' },
  { id: 'SS',  min: 160, name: 'マスター' },
  { id: 'SSS', min: 200, name: 'グランドマスター' },
  { id: 'GOD', min: 250, name: 'レジェンド' },
];
const PROFILES = {
  friendly: { label: 'やさしめ', scale: 0.8,  desc: '基準を20%緩和。一般的なタイピングアプリのランク感に近い設定' },
  standard: { label: '標準',     scale: 1.0,  desc: '基準そのまま（既定）' },
  strict:   { label: '厳格',     scale: 1.25, desc: '基準を25%引き上げ。競技・検定向け' },
};
function ladderFor(profileId) {
  const sc = (PROFILES[profileId] || PROFILES.standard).scale;
  return LADDER.map((r) => ({ ...r, min: Math.round(r.min * sc) }));
}
function rankFromCpm(cpm, profileId) {
  const lad = ladderFor(profileId);
  let idx = 0;
  for (let i = 0; i < lad.length; i++) if (cpm >= lad[i].min) idx = i;
  const next = lad[idx + 1] || null;
  return { rank: lad[idx], idx, next, toNext: next ? Math.max(0, Math.ceil(next.min - cpm)) : 0, ladder: lad };
}
function accuracyGrade(acc) {
  if (acc >= 99.5) return { id: 'S', label: '完璧' };
  if (acc >= 98.5) return { id: 'A', label: '極めて正確' };
  if (acc >= 97) return { id: 'B', label: '正確' };
  if (acc >= 94) return { id: 'C', label: '要注意' };
  if (acc >= 90) return { id: 'D', label: 'ミス多め' };
  return { id: 'E', label: '精度不足' };
}

/* ---- ペース系列（実測の確定文字数の推移から算出） ---- */
function paceSeries(events, totalSec, win) {
  const out = [];
  const nAt = (t) => { let v = 0; for (const e of events) { if (e.t <= t) v = e.n; else break; } return v; };
  const K = Math.floor(totalSec / win);
  for (let k = 0; k < K; k++) {
    const d = Math.max(0, nAt((k + 1) * win) - nAt(k * win));
    out.push({ t: (k + 1) * win, cpm: Math.round((d * 60) / win) });
  }
  return out;
}
function stabilityOf(events, totalSec) {
  const w = paceSeries(events, totalSec, 20).slice(1); // 立ち上がり区間を除外
  if (w.length < 3) return null;
  const v = w.map((x) => x.cpm), mean = v.reduce((a, b) => a + b, 0) / v.length;
  if (mean <= 0) return null;
  const sd = Math.sqrt(v.reduce((a, b) => a + (b - mean) ** 2, 0) / v.length);
  const cv = sd / mean;
  return { score: Math.max(0, Math.min(100, Math.round((1 - cv) * 100))), cv: Number(cv.toFixed(2)), windows: w.length };
}
function staminaOf(events, totalSec) {
  const w = paceSeries(events, totalSec, 20);
  if (w.length < 6) return null;
  const third = Math.floor(w.length / 3);
  const avg = (a) => a.reduce((s, x) => s + x.cpm, 0) / a.length;
  const first = avg(w.slice(0, third)), last = avg(w.slice(-third));
  if (first <= 0) return null;
  return { retention: Math.min(120, Math.round((last / first) * 100)), first: Math.round(first), last: Math.round(last) };
}

/* ---- セッション評価（結果画面・履歴の唯一の算出元） ---- */
function evaluateSession({ sections, level = 'standard', timing, profile = 'standard', mode = 'free', events = [], laps = [] }) {
  const per = [];
  let T = { evalLen: 0, inputLen: 0, ok: 0, sub: 0, miss: 0, extra: 0, dist: 0, denom: 0 };
  const cls = {}; Object.keys(CLASS_LABEL).forEach((k) => (cls[k] = { total: 0, ok: 0 }));
  const blocks = [];
  let okKeys = 0;
  sections.forEach((s, idx) => {
    const tArr = toG(normalizeForJudge(s.target, level)), iArr = toG(normalizeForJudge(s.input, level));
    const r = alignGraphemes(tArr, iArr, !s.full);
    const denom = Math.max(r.evalLen, r.inputLen);
    T.evalLen += r.evalLen; T.inputLen += r.inputLen; T.ok += r.ok; T.sub += r.sub; T.miss += r.miss; T.extra += r.extra; T.dist += r.dist; T.denom += denom;
    for (const sg of r.segs) {
      if (sg.k !== 'extra') { const c = classOf(sg.a); cls[c].total++; if (sg.k === 'ok') { cls[c].ok++; okKeys += estimateKeys(sg.a); } }
    }
    const bl = buildBlocks(r.segs, tArr).map((b) => ({ ...b, section: idx + 1 }));
    blocks.push(...bl);
    const lap = laps[idx];
    per.push({
      index: idx + 1, evalLen: r.evalLen, inputLen: r.inputLen, ok: r.ok, sub: r.sub, miss: r.miss, extra: r.extra,
      accuracy: denom > 0 ? Number(((1 - r.dist / denom) * 100).toFixed(1)) : 0,
      sec: lap ? Number(lap.sec.toFixed(1)) : null,
      cpm: lap && lap.sec > 1 ? Math.round((r.ok * 60) / lap.sec) : null,
      full: !!s.full, segs: r.segs,
    });
  });
  const accuracy = T.denom > 0 ? Math.max(0, Number(((1 - T.dist / T.denom) * 100).toFixed(1))) : 0;
  const sec = Math.max(timing.sec, 0.001), min = sec / 60;
  const netCpm = Math.round(T.ok / min), grossCpm = Math.round(T.inputLen / min);
  const eqKeysPerSec = Number((okKeys / sec).toFixed(1));
  const rk = rankFromCpm(netCpm, profile);
  const stability = stabilityOf(events, sec), stamina = staminaOf(events, sec);

  const speedPts = Math.min(600, Math.round((600 * netCpm) / ladderFor(profile)[LADDER.length - 1].min));
  const accPts = Math.round(300 * Math.max(0, Math.min(1, (accuracy - 85) / 15)));
  const stabPts = stability ? Math.round(stability.score) : null;
  const score = stabPts === null ? Math.round(((speedPts + accPts) * 1000) / 900) : speedPts + accPts + stabPts;

  const reasons = [];
  if (T.ok < 80) reasons.push('評価対象の正解文字数が80字未満');
  if (sec < 30) reasons.push('計測時間が30秒未満');
  if (accuracy < 85) reasons.push('正確率が85%未満（速度の信頼性が不足）');
  const limit = timing.limitSec || 0;
  if (limit > 0 && timing.finishedBy !== 'timeup') reasons.push('制限時間の終了前に終了（教材を打ち切った／途中終了）');
  if (timing.finishedBy === 'sudden') reasons.push('即死モードのため途中で終了');
  const certified = reasons.length === 0;

  const typeCounts = {};
  blocks.forEach((b) => { typeCounts[b.kind] = (typeCounts[b.kind] || 0) + 1; });
  const pairCounts = {};
  blocks.forEach((b) => { if (b.target && b.input) { const k = b.target + '→' + b.input; pairCounts[k] = (pairCounts[k] || 0) + 1; } });

  return {
    totals: { ...T, accuracy, correct: T.ok },
    speed: { netCpm, grossCpm, eqKeysPerSec, refKeysPerChar: REF_KEYS_PER_CHAR },
    timing: { ...timing, sec: Number(sec.toFixed(1)) },
    rank: { id: rk.rank.id, name: rk.rank.name, idx: rk.idx, next: rk.next, toNext: rk.toNext, ladder: rk.ladder, profile },
    accGrade: accuracyGrade(accuracy),
    stability, stamina,
    score: { total: Math.min(1000, score), speedPts, accPts, stabPts },
    reliability: { certified, reasons },
    classes: Object.fromEntries(Object.entries(cls).map(([k, v]) => [k, { ...v, acc: v.total ? Number(((v.ok / v.total) * 100).toFixed(1)) : null }])),
    blocks, typeCounts, pairCounts,
    sections: per,
    pace: paceSeries(events, sec, 10),
    mode, level,
  };
}

/* ---- 教材の区間分割 ---- */
function sanitizeMaterialText(raw) {
  return (raw || '')
    .replace(/\r\n?/g, '\n')
    .replace(/[\u200B-\u200D\uFEFF]/g, '')
    .replace(/^\s*(#{1,6}|[*\-+>]|\d+[.)])\s+/gm, '')
    .replace(/[*_`~]{1,3}/g, '')
    .replace(/[“”]/g, '"').replace(/[‘’]/g, "'")
    .replace(/[ \t\u3000]+/g, ' ')
    .replace(/\n{2,}/g, '\n')
    .trim();
}
function splitIntoSections(text, target = 200) {
  const paras = sanitizeMaterialText(text).split('\n').map((s) => s.trim()).filter(Boolean);
  const sentences = [];
  for (const p of paras) {
    const arr = p.match(/[^。！？!?]+[。！？!?]*|[。！？!?]+/g) || [p];
    for (let s of arr) {
      s = s.trim(); if (!s) continue;
      const hard = Math.round(target * 1.4);
      while (toG(s).length > hard) {
        const g = toG(s); let cut = -1;
        for (let k = Math.min(g.length - 1, hard); k > target * 0.5; k--) { if ('、，,'.includes(g[k])) { cut = k + 1; break; } }
        if (cut < 0) cut = hard;
        sentences.push(g.slice(0, cut).join('')); s = g.slice(cut).join('');
      }
      if (s) sentences.push(s);
    }
  }
  const out = []; let cur = '';
  for (const s of sentences) {
    const len = toG(cur).length, add = toG(s).length;
    if (cur && len >= target * 0.8 && len + add > target * 1.25) { out.push(cur); cur = s; }
    else cur += s;
  }
  if (cur) {
    if (out.length && toG(cur).length < target * 0.4 && toG(out[out.length - 1] + cur).length <= target * 1.6) out[out.length - 1] += cur;
    else out.push(cur);
  }
  return out;
}
/* ===== ENGINE END ===== */

/* ============================================================================
   AI LAYER : Gemini Flash（Canvas実行環境がキーを自動付与。ユーザーのAPIキーは不要）
   ========================================================================== */
const apiKey = ''; // ← Canvasが実行時に注入します。空のままにしてください。
const GEMINI_MODELS = ['gemini-2.5-flash-preview-09-2025', 'gemini-2.5-flash'];

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

async function callGemini({ parts, system, schema, temperature = 0.8, maxTokens = 8192, signal }) {
  const base = {
    contents: [{ role: 'user', parts }],
    systemInstruction: { parts: [{ text: system }] },
  };
  let lastErr = null;
  for (const model of GEMINI_MODELS) {
    for (const useThinkingCfg of [true, false]) {
      const gen = { temperature, maxOutputTokens: maxTokens };
      if (schema) { gen.responseMimeType = 'application/json'; gen.responseSchema = schema; }
      if (useThinkingCfg) gen.thinkingConfig = { thinkingBudget: 0 };
      const body = JSON.stringify({ ...base, generationConfig: gen });
      const url = `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${apiKey}`;
      let retryable = true;
      for (let attempt = 0; attempt < 4 && retryable; attempt++) {
        try {
          const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body, signal });
          if (res.ok) {
            const data = await res.json();
            const txt = (data?.candidates?.[0]?.content?.parts || []).map((p) => p.text || '').join('');
            if (!txt) throw new Error('AIから空の応答が返りました');
            if (!schema) return txt;
            const clean = txt.replace(/^```(?:json)?\s*/i, '').replace(/```\s*$/i, '').trim();
            return JSON.parse(clean);
          }
          if (res.status === 429 || res.status >= 500) { lastErr = new Error(`AI混雑中 (${res.status})`); await sleep(1000 * 2 ** attempt); continue; }
          lastErr = new Error(`AIエラー (${res.status})`); retryable = false;
        } catch (e) {
          if (e?.name === 'AbortError') throw e;
          lastErr = e; if (e instanceof SyntaxError) { retryable = attempt < 1; } else if (attempt < 3) await sleep(1000 * 2 ** attempt); else retryable = false;
        }
      }
      if (!useThinkingCfg) break;
    }
  }
  throw lastErr || new Error('AIに接続できませんでした');
}

const S = (d) => ({ type: 'STRING', description: d });
const SARR = (d) => ({ type: 'ARRAY', description: d, items: { type: 'STRING' } });

/* ---- 教材生成 ---- */
async function aiGenerateMaterial({ theme, genre, difficulty, chars, style, focus, signal }) {
  const system = [
    'あなたは日本語タイピング練習用の教材を書くプロの文章作家です。',
    '次の規則を厳守してください。',
    '1. 完全オリジナルの文章のみ。既存の小説・歌詞・記事・著作物の引用や模倣はしない。',
    '2. 見出し・箇条書き・マークダウン・絵文字・英語の注釈を使わない。普通の文章段落だけで構成する。',
    '3. 句読点は全角の「、」「。」。括弧は「」のみ。数字は半角アラビア数字か漢数字。全角英数字は使わない。',
    '4. IMEで入力して自然に変換できる語を使う。極端に珍しい漢字・外字・旧字体・難読固有名詞は避ける。',
    '5. 事実関係が怪しい断定は避け、一般的に正しい内容か、明らかな創作として書く。',
    '6. 段落は改行1つで区切る。空行は入れない。',
  ].join('\n');
  const prompt = [
    `テーマ: ${theme || '自由（読み物として面白いもの）'}`,
    `ジャンル: ${genre}`,
    `漢字の密度・難易度: ${difficulty}`,
    `文体: ${style}`,
    `目標文字数: 約${chars}文字（前後10%以内）`,
    focus ? `次の語句・文字を文章中に自然に複数回含めること（苦手克服用）: ${focus}` : '',
    'title には内容を表す短い題名を、text には本文のみを入れてください。',
  ].filter(Boolean).join('\n');
  const out = await callGemini({
    system, parts: [{ text: prompt }], temperature: 0.9, signal,
    maxTokens: Math.min(16000, chars * 3 + 1024),
    schema: { type: 'OBJECT', properties: { title: S('題名（20文字以内）'), text: S('本文') }, required: ['title', 'text'] },
  });
  return { title: String(out.title || '無題').slice(0, 40), text: sanitizeMaterialText(out.text) };
}

/* ---- PDF／画像からの文字起こし（Geminiのマルチモーダル） ---- */
async function aiExtractFromFile({ base64, mimeType, signal }) {
  const system = 'あなたは正確な文字起こし担当です。与えられた文書の本文を、要約・翻訳・補足・修正をせず原文のまま書き起こします。ページ番号・ヘッダー・フッター・図表キャプションなど本文でない要素は除きます。改行は段落の区切りのみ残し、行末の折り返しによる改行は取り除いてください。';
  const out = await callGemini({
    system, temperature: 0, signal, maxTokens: 16000,
    parts: [{ text: '本文を書き起こしてください。title には文書の題名（なければ内容を表す短い題）を入れてください。' }, { inlineData: { mimeType, data: base64 } }],
    schema: { type: 'OBJECT', properties: { title: S('題名'), text: S('本文（原文のまま）') }, required: ['title', 'text'] },
  });
  return { title: String(out.title || '取り込み教材').slice(0, 40), text: sanitizeMaterialText(out.text) };
}

/* ---- 貼り付けテキストの整形（内容は変えない） ---- */
async function aiCleanText({ text, signal }) {
  const system = 'あなたは文章整形ツールです。内容・語句・表記を一切変えず、PDFやWebからの貼り付けで生じた不要な改行、ページ番号、脚注番号、連続空白、文字化け的な記号だけを取り除きます。要約・言い換え・追記は禁止。段落の区切りは改行1つで残します。';
  const out = await callGemini({
    system, temperature: 0, signal, maxTokens: 16000,
    parts: [{ text }],
    schema: { type: 'OBJECT', properties: { text: S('整形後の本文') }, required: ['text'] },
  });
  return sanitizeMaterialText(out.text);
}

/* ---- AIコーチ（判定には一切影響しない。実測値のみを根拠にする） ---- */
async function aiCoach({ result, signal }) {
  const system = [
    'あなたは日本語タイピングの専属コーチです。',
    '渡された実測データだけを根拠に分析してください。データにないことは断定せず「可能性」と明示すること。',
