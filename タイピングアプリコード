            <tbody className="tf-mono">{LADDER.map((x, i) => (<tr key={x.id}><td className="!font-sans font-bold" style={{ color: RANK_COLOR[x.id] }}>{x.id} {x.name}</td>{Object.keys(PROFILES).map((k) => <td key={k} style={k === profile ? { color: 'var(--gd)', fontWeight: 700 } : null}>{ladderFor(k)[i].min}以上</td>)}<td className="c-mu">≈{((x.min * REF_KEYS_PER_CHAR) / 60).toFixed(1)}</td></tr>))}</tbody></table></div></section>
