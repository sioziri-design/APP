  { v: '難しい（漢語・専門語・同音異義語を多く含む）', l: '難しい' },
];
const STYLES = [{ v: 'です・ます調', l: 'です・ます' }, { v: 'だ・である調', l: 'だ・である' }];
const THEME_CHIPS = ['再生可能エネルギーの現在地', '雨の日の商店街', '新入社員への業務依頼メール', '深海探査の最前線', '江戸の町人文化', '週末の山小屋', '睡眠と記憶の関係', '地方の小さな図書館'];

function HomeView({ material, setMaterial, library, setLibrary, mode, setMode, settings, setSettings, onStart, toast, onOpenMethod, history }) {
  const [tab, setTab] = useState('ai');
  const [form, setForm] = useState({ theme: '', genre: GENRES[0], difficulty: DIFFS[1].v, chars: 1000, style: STYLES[0].v });
  const [busy, setBusy] = useState('');
  const [err, setErr] = useState('');
  const [paste, setPaste] = useState({ title: '', text: '' });
  const acRef = useRef(null);
  const fileRef = useRef(null);

  const adopt = (m) => {
    const full = { id: uid(), createdAt: new Date().toISOString(), ...m };
    setMaterial(full);
    setLibrary((lib) => [full, ...lib.filter((x) => x.text !== full.text)].slice(0, 40));
  };
  const run = async (kind, fn) => {
    setBusy(kind); setErr('');
    const ac = new AbortController(); acRef.current = ac;
    try { await fn(ac.signal); } catch (e) { if (e?.name !== 'AbortError') setErr(`${e?.message || 'AI処理に失敗しました'}。少し待ってもう一度お試しください。`); }
    finally { setBusy(''); }
  };
  const generate = (focus) => run('gen', async (signal) => {
    const r = await aiGenerateMaterial({ ...form, focus, signal });
    if (toG(r.text).length < 40) throw new Error('生成された文章が短すぎました');
    adopt({ title: r.title, text: r.text, source: 'ai' }); toast('教材を生成しました', 'ok');
  });
  const onFile = (f) => {
    if (!f) return;
    const name = f.name.replace(/\.[^.]+$/, '');
    if (/\.(txt|md)$/i.test(f.name) || f.type.startsWith('text/')) {
      const rd = new FileReader(); rd.onload = () => { const t = sanitizeMaterialText(String(rd.result)); if (toG(t).length < 20) return setErr('テキストが短すぎます'); adopt({ title: name, text: t, source: 'file' }); toast('ファイルを読み込みました', 'ok'); }; rd.readAsText(f, 'utf-8'); return;
    }
    if (!/(pdf|png|jpe?g|webp)$/i.test(f.name)) return setErr('対応形式: txt / md / pdf / png / jpg / webp');
    if (f.size > 14 * 1024 * 1024) return setErr('ファイルが大きすぎます（14MBまで）');
    run('file', async (signal) => {
      const b64 = await new Promise((res, rej) => { const rd = new FileReader(); rd.onload = () => res(String(rd.result).split(',')[1]); rd.onerror = rej; rd.readAsDataURL(f); });
      const mime = f.type || (/pdf$/i.test(f.name) ? 'application/pdf' : 'image/png');
      const r = await aiExtractFromFile({ base64: b64, mimeType: mime, signal });
      if (toG(r.text).length < 20) throw new Error('文字を抽出できませんでした');
      adopt({ title: r.title || name, text: r.text, source: 'file' }); toast('AIで本文を抽出しました', 'ok');
    });
  };

  const chars = material ? toG(normalizeForJudge(material.text, 'standard')).length : 0;
  const nSec = material ? splitIntoSections(material.text, settings.sectionLen).length : 0;
  const need = MODES[mode].sec ? Math.round((MODES[mode].sec / 60) * 220) : 0;
  const best = history.reduce((m, h) => Math.max(m, h.speed.netCpm), 0);

  return (
    <div className="max-w-6xl mx-auto px-4 py-6 grid lg:grid-cols-5 gap-5">
      <section className="lg:col-span-3 tf-card p-5" aria-labelledby="h-material">
        <div className="flex items-center justify-between mb-3">
          <h2 id="h-material" className="font-bold text-base flex items-center gap-2"><Ic n="book" className="c-ai" />練習する文章</h2>
          {material && <span className="tf-h">選択中：{material.title}</span>}
        </div>
        <div className="flex flex-wrap gap-1.5 mb-4" role="tablist">
          {[['ai', 'AIで作る', 'spark'], ['paste', '貼り付け', 'pen'], ['file', 'ファイル/PDF', 'upload'], ['saved', `保存済み (${library.length})`, 'file']].map(([k, l, ic]) => (
            <button key={k} role="tab" aria-selected={tab === k} className="tf-chip flex items-center gap-1.5" aria-pressed={tab === k} onClick={() => { setTab(k); setErr(''); }}><Ic n={ic} s={13} />{l}</button>
          ))}
        </div>

        {tab === 'ai' && (
          <div className="space-y-3.5">
            <div>
              <label className="tf-h block mb-1" htmlFor="theme">テーマ（空欄ならAIにおまかせ）</label>
              <input id="theme" className="tf-input" value={form.theme} placeholder="例：港町の朝市／新製品の発表を伝える社内文書" onChange={(e) => setForm({ ...form, theme: e.target.value })} />
              <div className="flex flex-wrap gap-1.5 mt-2">{THEME_CHIPS.map((t) => (<button key={t} className="tf-chip" onClick={() => setForm({ ...form, theme: t })}>{t}</button>))}</div>
            </div>
            <div className="grid sm:grid-cols-2 gap-3.5">
              <div><div className="tf-h mb-1">ジャンル</div><select className="tf-input" value={form.genre} onChange={(e) => setForm({ ...form, genre: e.target.value })}>{GENRES.map((g) => <option key={g}>{g}</option>)}</select></div>
              <div><div className="tf-h mb-1">文体</div><Seg label="文体" value={form.style} onChange={(v) => setForm({ ...form, style: v })} options={STYLES} /></div>
              <div><div className="tf-h mb-1">漢字の密度・難易度</div><Seg label="難易度" value={form.difficulty} onChange={(v) => setForm({ ...form, difficulty: v })} options={DIFFS} /></div>
              <div><div className="tf-h mb-1">文字数</div><Seg label="文字数" value={form.chars} onChange={(v) => setForm({ ...form, chars: v })} options={[400, 800, 1200, 2000, 3000].map((n) => ({ v: n, l: `${n}字` }))} /></div>
            </div>
            <div className="flex items-center gap-2.5 pt-1">
              <button className="tf-btn tf-btn-ai" disabled={!!busy} onClick={() => generate('')}>{busy === 'gen' ? <Spinner /> : <Ic n="spark" />}{busy === 'gen' ? 'Gemini Flashが執筆中…' : 'AIで教材を生成'}</button>
              {busy === 'gen' && <button className="tf-btn" onClick={() => acRef.current?.abort()}>中止</button>}
              <span className="tf-h">毎回オリジナルの文章を生成します</span>
            </div>
          </div>
        )}

        {tab === 'paste' && (
          <div className="space-y-3">
            <input className="tf-input" placeholder="教材名（任意）" value={paste.title} onChange={(e) => setPaste({ ...paste, title: e.target.value })} aria-label="教材名" />
            <textarea className="tf-input tf-scroll" rows={9} placeholder="練習したい文章を貼り付けてください。PDFやWebからの貼り付けで改行が乱れている場合は「AIで整形」が使えます。" value={paste.text} onChange={(e) => setPaste({ ...paste, text: e.target.value })} aria-label="貼り付けテキスト" />
            <div className="flex flex-wrap items-center gap-2.5">
              <button className="tf-btn tf-btn-main" disabled={toG(paste.text).length < 20} onClick={() => { adopt({ title: paste.title.trim() || '貼り付け教材', text: sanitizeMaterialText(paste.text), source: 'paste' }); toast('教材をセットしました', 'ok'); }}><Ic n="check" />この文章を使う</button>
              <button className="tf-btn tf-btn-ai" disabled={!!busy || toG(paste.text).length < 20} onClick={() => run('clean', async (signal) => { const t = await aiCleanText({ text: paste.text.slice(0, 20000), signal }); setPaste((p) => ({ ...p, text: t })); toast('AIで整形しました（内容は変更していません）', 'ok'); })}>{busy === 'clean' ? <Spinner /> : <Ic n="spark" />}AIで整形</button>
              <span className="tf-h tf-mono">{toG(paste.text).length.toLocaleString()} 字</span>
            </div>
          </div>
        )}

        {tab === 'file' && (
          <div className="space-y-3">
            <button className="w-full tf-card2 py-9 flex flex-col items-center gap-2 cursor-pointer hover:border-[#3a4554]" disabled={!!busy} onClick={() => fileRef.current?.click()} onDragOver={(e) => e.preventDefault()} onDrop={(e) => { e.preventDefault(); onFile(e.dataTransfer.files?.[0]); }}>
              {busy === 'file' ? <Spinner s={22} /> : <Ic n="upload" s={22} className="c-ai" />}
              <span className="text-sm font-semibold">{busy === 'file' ? 'AIが本文を読み取っています…' : 'ファイルをここへドロップ、またはクリックして選択'}</span>
              <span className="tf-h">txt / md はそのまま読込、PDF・画像は Gemini が本文を書き起こします（14MBまで）</span>
            </button>
            <input ref={fileRef} type="file" accept=".txt,.md,.pdf,.png,.jpg,.jpeg,.webp,text/plain" className="hidden" onChange={(e) => { onFile(e.target.files?.[0]); e.target.value = ''; }} />
          </div>
        )}

        {tab === 'saved' && (
          <div className="space-y-2 max-h-80 overflow-y-auto tf-scroll pr-1">
            {library.length === 0 && <div className="c-mu text-sm py-8 text-center">保存済みの教材はまだありません。<br />AI生成・貼り付け・ファイル読込で作成した教材が自動で保存されます。</div>}
            {library.map((m) => (
              <div key={m.id} className="tf-card2 px-3 py-2.5 flex items-center gap-3">
                <button className="flex-1 text-left min-w-0" onClick={() => { setMaterial(m); toast(`「${m.title}」をセットしました`, 'ok'); }}>
                  <div className="text-sm font-semibold truncate">{m.title}</div>
                  <div className="tf-h tf-mono">{toG(m.text).length.toLocaleString()}字 ・ {fmtDate(m.createdAt)} ・ {m.source === 'ai' ? 'AI生成' : m.source === 'file' ? 'ファイル' : '貼り付け'}</div>
                </button>
                <button className="tf-btn !p-1.5" aria-label="削除" onClick={() => setLibrary((lib) => lib.filter((x) => x.id !== m.id))}><Ic n="trash" s={14} /></button>
              </div>
            ))}
          </div>
        )}

        {err && <div className="mt-3 tf-card2 px-3 py-2 text-sm c-sh flex items-start gap-2" role="alert"><Ic n="warn" className="mt-0.5 shrink-0" />{err}</div>}

        {material ? (
          <div className="mt-4 tf-card2 p-3.5">
            <div className="flex items-center justify-between gap-3 mb-1.5"><div className="font-semibold text-sm truncate">{material.title}</div><span className="tf-h tf-mono shrink-0">{chars.toLocaleString()}字 / {nSec}区間</span></div>
            <p className="tf-serif text-[13px] c-mu leading-relaxed line-clamp-3" style={{ display: '-webkit-box', WebkitLineClamp: 3, WebkitBoxOrient: 'vertical', overflow: 'hidden' }}>{material.text}</p>
          </div>
        ) : (
          <div className="mt-4 tf-card2 p-4 text-sm c-mu">教材が未選択です。「AIで作る」からテーマを選んで生成するか、手持ちの文章を貼り付けてください。</div>
        )}
      </section>

      <aside className="lg:col-span-2 space-y-5">
        <section className="tf-card p-5" aria-labelledby="h-mode">
          <h2 id="h-mode" className="font-bold text-base flex items-center gap-2 mb-3"><Ic n="clock" className="c-gd" />測定モード</h2>
          <div className="grid grid-cols-4 gap-1.5">
            {Object.entries(MODES).map(([k, m]) => (<button key={k} className="tf-chip text-center" aria-pressed={mode === k} onClick={() => setMode(k)} title={m.desc}>{m.label}</button>))}
          </div>
          <p className="tf-h mt-2.5">{MODES[mode].desc}</p>
          {need > 0 && chars > 0 && chars < need && <p className="text-xs c-gd mt-2 flex gap-1.5"><Ic n="warn" s={14} className="shrink-0 mt-0.5" />この教材（{chars}字）は{MODES[mode].label}測定には短めです。{need}字以上を推奨。文章を使い切ると、その時点で終了します。</p>}

          <h3 className="font-bold text-sm mt-5 mb-2 flex items-center gap-2"><Ic n="shield" s={15} className="c-ai" />判定条件</h3>
          <div className="space-y-3">
            <div><div className="tf-h mb-1">ランク基準</div><Seg label="ランク基準" value={settings.profile} onChange={(v) => setSettings({ ...settings, profile: v })} options={Object.entries(PROFILES).map(([k, p]) => ({ v: k, l: p.label, t: p.desc }))} /></div>
            <div><div className="tf-h mb-1">文字の照合</div><Seg label="文字の照合" value={settings.level} onChange={(v) => setSettings({ ...settings, level: v })} options={Object.entries(MATCH_LEVELS).map(([k, p]) => ({ v: k, l: p.label, t: p.desc }))} /><p className="tf-h mt-1">{MATCH_LEVELS[settings.level].desc}</p></div>
            <div><div className="tf-h mb-1">1区間の長さ</div><Seg label="区間の長さ" value={settings.sectionLen} onChange={(v) => setSettings({ ...settings, sectionLen: v })} options={[100, 150, 200, 300].map((n) => ({ v: n, l: `約${n}字` }))} /></div>
          </div>
          <button className="tf-btn w-full mt-4" onClick={onOpenMethod}><Ic n="info" />判定のしくみ（計算式と基準表）を見る</button>
        </section>

        <button className="tf-btn tf-btn-main w-full !py-3.5 !text-base" disabled={!material || chars < 20} onClick={onStart}><Ic n="play" s={18} />{MODES[mode].label}で開始</button>
        {best > 0 && <div className="tf-card2 px-4 py-3 text-sm flex items-center justify-between"><span className="c-mu">自己最高 正味速度</span><span className="tf-mono font-bold c-gd">{best} 字/分</span></div>}
      </aside>
    </div>
  );
}

/* ============================================================================
   TYPING : 入力セッション（変換確定後の文字だけを計測）
   ========================================================================== */
function mapDisplay(raw, level) {
  const out = []; let ni = 0;
  for (const g of toG(raw)) {
    const n = toG(normalizeForJudge(g, level)).length;
    out.push({ ch: g, ni: n > 0 ? ni : -1 });
    ni += n;
  }
  return out;
}

function TypingSession({ material, mode, settings, onFinish, onAbort, toast }) {
  const sections = useMemo(() => splitIntoSections(material.text, settings.sectionLen), [material, settings.sectionLen]);
  const limit = MODES[mode].sec;
  const level = settings.level;
  const totalChars = useMemo(() => sections.reduce((a, s) => a + toG(normalizeForJudge(s, level)).length, 0), [sections, level]);

  const [idx, setIdx] = useState(0);
  const [text, setText] = useState('');
  const [committed, setCommitted] = useState('');
  const [started, setStarted] = useState(false);
  const [, setTick] = useState(0);
  const [laps, setLaps] = useState([]);
  const taRef = useRef(null);
  const R = useRef({
    start: null, last: null, activeMs: 0, composing: false, lastCompEnd: 0, idx: 0, inputs: [], laps: [], events: [],
    committedVal: '', secStartAxis: null, commitActiveMs: 0, commitWallMs: 0, confirmedN: 0, agg: { ok: 0, dist: 0, denom: 0, evalLen: 0 }, finished: false,
  });

  const axisSec = () => {
    const r = R.current; if (r.start == null) return 0;
    if (limit > 0) return (performance.now() - r.start) / 1000;
    return (r.activeMs + Math.min(performance.now() - r.last, IDLE_CAP_MS)) / 1000;
  };
  const axisAtCommit = () => { const r = R.current; return limit > 0 ? (r.commitWallMs - r.start) / 1000 : r.commitActiveMs / 1000; };
  const markActivity = () => {
    const r = R.current, t = performance.now();
    if (r.start == null) { r.start = t; r.last = t; setStarted(true); }
    else { r.activeMs += Math.min(t - r.last, IDLE_CAP_MS); r.last = t; }
    if (r.secStartAxis == null) r.secStartAxis = axisSec();
  };
  const focusTa = () => setTimeout(() => taRef.current?.focus(), 30);

  const finish = (reason) => {
    const r = R.current; if (r.finished) return; r.finished = true;
    const secs = r.inputs.map((inp, k) => ({ target: sections[k], input: inp, full: true }));
    const lapArr = [...r.laps];
    const k = r.inputs.length;
    if (reason !== 'complete' && k < sections.length && toG(normalizeForJudge(r.committedVal, level)).length > 0) {
      secs.push({ target: sections[k], input: r.committedVal, full: false });
      lapArr[k] = { sec: r.secStartAxis != null ? Math.max(0, axisAtCommit() - r.secStartAxis) : 0 };
    }
    if (secs.length === 0 || r.start == null) { toast('入力がないため記録しませんでした', 'info'); onAbort(); return; }
    const sec = reason === 'timeup' ? limit : Math.max(0.5, axisAtCommit());
    if (settings.sound) sfx.done(settings.volume);
    const ev = evaluateSession({
      sections: secs, level, profile: settings.profile, mode, events: r.events, laps: lapArr,
      timing: { sec, limitSec: limit, finishedBy: reason, basis: limit > 0 ? 'wall' : 'active', wallSec: Number(((r.commitWallMs - r.start) / 1000).toFixed(1)), idleCapSec: IDLE_CAP_MS / 1000 },
    });
    onFinish({ id: uid(), at: new Date().toISOString(), title: material.title, materialId: material.id, materialChars: totalChars, ...ev });
  };
  const finishRef = useRef(finish); finishRef.current = finish;

  const confirmSection = (val) => {
    const r = R.current; if (r.finished) return;
    const i = r.idx;
    const tArr = toG(normalizeForJudge(sections[i], level)), iArr = toG(normalizeForJudge(val, level));
    const a = alignGraphemes(tArr, iArr, false);
    r.inputs[i] = val;
    const sec = r.secStartAxis != null ? Math.max(0, axisAtCommit() - r.secStartAxis) : 0;
    r.laps[i] = { sec };
    const denom = Math.max(a.evalLen, a.inputLen);
    r.agg.ok += a.ok; r.agg.dist += a.dist; r.agg.denom += denom; r.agg.evalLen += a.evalLen;
    r.confirmedN += iArr.length;
    setLaps((rows) => [...rows, { i: i + 1, acc: denom ? Number(((1 - a.dist / denom) * 100).toFixed(1)) : 0, cpm: sec > 1 ? Math.round((a.ok * 60) / sec) : null, sec, err: a.dist }]);
    if (settings.sound) (a.dist === 0 ? sfx.ok : sfx.ng)(settings.volume);
    if (i + 1 < sections.length) {
      r.idx = i + 1; r.secStartAxis = null; r.committedVal = '';
      setIdx(i + 1); setText(''); setCommitted(''); focusTa();
    } else finish('complete');
  };

  const commit = (val) => {
    const r = R.current; if (r.finished || val === r.committedVal) return;
    r.committedVal = val; setCommitted(val);
    r.commitWallMs = performance.now(); r.commitActiveMs = r.activeMs;
    const iArr = toG(normalizeForJudge(val, level));
    r.events.push({ t: axisAtCommit(), n: r.confirmedN + iArr.length });
    const tArr = toG(normalizeForJudge(sections[r.idx], level));
    if (mode === 'sudden') {
      let bad = iArr.length > tArr.length;
      for (let k = 0; k < iArr.length && !bad; k++) if (iArr[k] !== tArr[k]) bad = true;
      if (bad) { if (settings.sound) sfx.ng(settings.volume); toast('ミスが出たため終了します', 'error'); finish('sudden'); return; }
    }
    if (iArr.length > 0 && iArr.length === tArr.length && iArr.every((c, k) => c === tArr[k])) confirmSection(val); // 完全一致 → 自動で次の区間へ
  };

  useEffect(() => {
    const id = setInterval(() => {
      setTick((x) => x + 1);
      const r = R.current;
      if (limit > 0 && r.start != null && !r.finished && (performance.now() - r.start) / 1000 >= limit) { toast(`${MODES[mode].label}の測定が終了しました`, 'ok'); finishRef.current('timeup'); }
    }, 200);
    taRef.current?.focus();
    return () => clearInterval(id);
  }, []); // eslint-disable-line

  const onKeyDown = (e) => {
    const r = R.current;
    if (e.key === 'Tab') { e.preventDefault(); return; }
    if (e.key === 'Enter') {
      const comp = e.nativeEvent.isComposing || e.keyCode === 229 || r.composing || performance.now() - r.lastCompEnd < 60;
      if (comp) { markActivity(); return; }
      e.preventDefault();
      if (e.shiftKey) return;
      markActivity();
      if (e.ctrlKey || e.metaKey) { confirmSection(r.committedVal); return; }
      const need = toG(normalizeForJudge(sections[r.idx], level)).length, have = toG(normalizeForJudge(r.committedVal, level)).length;
      if (have >= need * 0.85) confirmSection(r.committedVal);
      else toast(`あと${need - have}字ほど入力してください（Ctrl+Enterで強制的に次へ）`, 'info');
      return;
    }
    if (!e.ctrlKey && !e.metaKey && !e.altKey) { markActivity(); if (settings.sound && (e.key.length === 1 || e.key === 'Backspace')) sfx.key(settings.volume); }
  };

  /* ---- 表示用の算出 ---- */
  const tArr = useMemo(() => toG(normalizeForJudge(sections[idx] || '', level)), [sections, idx, level]);
  const disp = useMemo(() => mapDisplay(sections[idx] || '', level), [sections, idx, level]);
  const live = useMemo(() => alignGraphemes(tArr, toG(normalizeForJudge(committed, level)), true), [tArr, committed, level]);
  const status = useMemo(() => { const a = new Array(tArr.length).fill('todo'); for (const s of live.segs) if (s.k !== 'extra' && s.ti < a.length) a[s.ti] = s.k; return a; }, [live, tArr]);

  const r = R.current;
  const t = axisSec();
  const okAll = r.agg.ok + live.ok;
  const denAll = r.agg.denom + Math.max(live.evalLen, live.inputLen);
  const distAll = r.agg.dist + live.dist;
  const liveCpm = t >= 6 ? Math.round((okAll * 60) / t) : null;
  const liveAcc = denAll > 0 ? (1 - distAll / denAll) * 100 : null;
  const progress = Math.min(100, Math.round(((r.agg.evalLen + live.evalLen) / Math.max(1, totalChars)) * 100));
  const rankNow = liveCpm != null ? rankFromCpm(liveCpm, settings.profile) : null;
  const remain = limit > 0 ? Math.max(0, limit - t) : null;
  const latin = (committed.match(/[A-Za-z]/g) || []).length;
  const imeOff = committed.length >= 5 && latin / committed.length > 0.5 && tArr.filter((c) => classOf(c) !== 'alnum').length / Math.max(1, tArr.length) > 0.5;
  const fs = { compact: '1.1rem', standard: '1.35rem', large: '1.6rem', huge: '1.9rem' }[settings.fontSize] || '1.35rem';
  const lh = { compact: '2.1rem', standard: '2.6rem', large: '3rem', huge: '3.5rem' }[settings.fontSize] || '2.6rem';
  const cursorIdx = live.evalLen;

  return (
    <div className="max-w-4xl mx-auto px-4 py-5">
      <div className="tf-card px-4 py-3 mb-4 flex flex-wrap items-center gap-x-6 gap-y-2" role="status" aria-live="off">
        <div><div className="tf-h">正味速度（正解字/分）</div><div className="tf-mono text-2xl font-bold">{liveCpm ?? '—'}{rankNow && <span className="text-sm ml-2" style={{ color: RANK_COLOR[rankNow.rank.id] }}>{rankNow.rank.id}</span>}</div></div>
        <div><div className="tf-h">正確率</div><div className="tf-mono text-2xl font-bold" style={{ color: liveAcc == null ? undefined : liveAcc >= 97 ? 'var(--gr)' : liveAcc >= 90 ? 'var(--gd)' : 'var(--sh)' }}>{liveAcc == null ? '—' : liveAcc.toFixed(1)}<span className="text-sm c-mu">%</span></div></div>
        <div><div className="tf-h">{limit > 0 ? '残り時間' : '計測時間'}</div><div className={`tf-mono text-2xl font-bold ${remain != null && remain <= 10 && started ? 'c-sh' : ''}`}>{fmtTime(remain != null ? remain : t)}</div></div>
        <div className="flex-1 min-w-[140px]"><div className="flex justify-between tf-h mb-1"><span>区間 {idx + 1}/{sections.length}</span><span className="tf-mono">{progress}%</span></div><div className="tf-bar"><i style={{ width: `${progress}%`, background: 'var(--ai)' }} /></div></div>
        <div className="flex gap-1.5">
          <button className="tf-btn" onClick={() => finish('manual')} title="ここまでの入力で判定します"><Ic n="check" s={14} />判定する</button>
          <button className="tf-btn" onClick={() => { R.current.finished = true; onAbort(); }} title="記録せずに戻ります"><Ic n="back" s={14} />中止</button>
        </div>
      </div>

      {mode === 'sudden' && <div className="mb-3 text-sm c-sh flex items-center gap-2"><Ic n="flame" />即死モード：確定した文字が1文字でも違った時点で終了します</div>}

      <div className="tf-paper p-5 sm:p-7 mb-4 cursor-text" onClick={() => taRef.current?.focus()}>
        <div className="flex items-center justify-between mb-2 text-xs" style={{ color: '#7a7566' }}><span>お手本（変換後の文字で照合します）</span><span className="tf-mono">{live.evalLen}/{tArr.length}字</span></div>
        <div className="tf-serif tf-ruled select-none break-all" style={{ fontSize: fs, lineHeight: lh, '--lh': lh, letterSpacing: '.06em' }} aria-label="お手本の文章">
          {disp.map((d, k) => {
            let cls = 'tf-todo';
            if (d.ni >= 0) { const st = status[d.ni]; cls = d.ni === cursorIdx && st === 'todo' ? 'tf-cur tf-todo' : st === 'ok' ? 'tf-done' : st === 'sub' ? 'tf-bad' : st === 'miss' ? 'tf-skip' : 'tf-todo'; }
            return <span key={k} className={cls}>{d.ch}</span>;
          })}
        </div>
        {sections[idx + 1] && <div className="mt-3 pt-2 text-xs truncate" style={{ color: '#8a8575', borderTop: '1px dashed rgba(100,90,60,.3)' }}>次：{sections[idx + 1]}</div>}
      </div>

      {imeOff && <div className="mb-3 tf-card2 px-3 py-2 text-sm c-gd flex items-center gap-2" role="alert"><Ic n="warn" />日本語IMEがオフの可能性があります（半角英字が多く入力されています）。「半角/全角」キーで切り替えてください。</div>}

      <textarea ref={taRef} value={text} rows={4} spellCheck={false} autoComplete="off" autoCapitalize="off" aria-label="入力欄"
        className="tf-input tf-serif" style={{ fontSize: fs, lineHeight: 1.9, padding: '14px 16px', resize: 'none' }}
        placeholder="日本語IMEをオンにして、お手本の文章を変換・確定しながら入力します"
        onChange={(e) => { const v = e.target.value; setText(v); markActivity(); if (!e.nativeEvent.isComposing && !R.current.composing) commit(v); }}
        onCompositionStart={() => { R.current.composing = true; markActivity(); }}
        onCompositionUpdate={() => markActivity()}
        onCompositionEnd={(e) => { R.current.composing = false; R.current.lastCompEnd = performance.now(); markActivity(); commit(e.currentTarget.value); }}
        onKeyDown={onKeyDown} />
      <div className="mt-2 flex flex-wrap items-center justify-between gap-2 tf-h">
        <span>入力 <b className="tf-mono c-gr">{live.inputLen}</b>字 ／ 誤り <b className={`tf-mono ${live.dist ? 'c-sh' : 'c-gr'}`}>{live.dist}</b>字（変換確定後の文字で判定）</span>
        <span>Enter＝区間確定（85%以上）／ Ctrl+Enter＝強制確定 ／ 完全一致で自動送り</span>
      </div>

      {laps.length > 0 && (
        <div className="tf-card mt-4 p-3">
          <div className="tf-h mb-1.5">完了した区間</div>
          <div className="flex flex-wrap gap-2">{laps.slice(-8).map((l) => (<div key={l.i} className="tf-card2 px-2.5 py-1.5 text-xs tf-mono"><span className="c-mu">#{l.i}</span> <b>{l.cpm ?? '—'}</b>字/分 <span className={l.err ? 'c-sh' : 'c-gr'}>{l.acc}%</span></div>))}</div>
        </div>
      )}
    </div>
  );
}

/* ============================================================================
   RESULT : 結果画面（判定根拠を数式つきで全公開）
   ========================================================================== */
function buildReport(r) {
  const L = [];
  L.push(`【TypingForge 測定レポート】${r.title}`);
  L.push(`日時: ${fmtDate(r.at)} / モード: ${MODES[r.mode]?.label} / 基準: ${PROFILES[r.rank.profile]?.label} / 照合: ${MATCH_LEVELS[r.level]?.label}`);
  L.push(`速度ランク: ${r.rank.id}（${r.rank.name}） ${r.reliability.certified ? '【認定】' : '【参考記録】' + r.reliability.reasons.join('／')}`);
  L.push(`正味速度: ${r.speed.netCpm}字/分（粗速度 ${r.speed.grossCpm}字/分）`);
  L.push(`正確率: ${r.totals.accuracy}%（誤字${r.totals.sub} 脱字${r.totals.miss} 余字${r.totals.extra} / 評価対象${r.totals.evalLen}字）`);
  L.push(`計測時間: ${r.timing.sec}秒（${r.timing.basis === 'wall' ? '壁時計' : 'アイドル除外'}）`);
  L.push(`総合スコア: ${r.score.total}/1000（速度${r.score.speedPts}/600 + 精度${r.score.accPts}/300 + 安定${r.score.stabPts ?? '算出不可'}/100）`);
  L.push(`判定方式: IMEで変換・確定された日本語の文字を1文字単位で照合（編集距離）。ローマ字は使用しない。`);
  return L.join('\n');
}

function Step({ no, title, children }) {
  return (
    <li className="flex gap-3">
      <div className="shrink-0 w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold tf-mono" style={{ background: 'var(--p3)', color: 'var(--gd)' }}>{no}</div>
      <div className="min-w-0 flex-1 pb-4" style={{ borderBottom: '1px solid rgba(42,51,64,.55)' }}>
        <div className="font-semibold text-sm mb-1">{title}</div>
        <div className="text-[13px] c-mu leading-relaxed space-y-1">{children}</div>
      </div>
    </li>
  );
}
const Fx = ({ children }) => <code className="tf-mono text-[12px] px-1.5 py-0.5 rounded" style={{ background: 'var(--bg)', color: '#cfd6df' }}>{children}</code>;

function Evidence({ r }) {
  const T = r.totals, min = r.timing.sec / 60;
  return (
    <ol className="space-y-3.5 list-none p-0 m-0">
      <Step no="1" title="評価の対象">
        <p>評価対象は <b className="text-[var(--tx)] tf-mono">{T.evalLen}</b> 字（{r.sections.length}区間）。{r.sections.some((s) => !s.full) ? '最後の区間は途中までの入力なので、まだ到達していない末尾はミス扱いにせず評価から外しています。' : '全区間を最後まで入力しています。'}変換が確定していない（変換中の）文字は計測に含みません。</p>
      </Step>
      <Step no="2" title="正誤の判定方法">
        <p><b className="text-[var(--tx)]">IMEで変換・確定された日本語の文字</b>を、お手本と1文字ずつ照合します。ローマ字の綴りや打鍵の並びは一切見ていません。「橋」と「箸」のように読みが同じでも別の文字は誤字です。</p>
        <p>お手本と入力の最適な対応づけ（編集距離）を求め、<b className="text-[var(--gr)]">正解</b>・誤字（置換）・脱字（入力漏れ）・余字（余分な入力）に分類します。照合基準：<b className="text-[var(--tx)]">{MATCH_LEVELS[r.level].label}</b>（{MATCH_LEVELS[r.level].desc}）</p>
      </Step>
      <Step no="3" title="文字数の内訳">
        <p><span className="c-gr">正解 {T.ok}</span> ／ <span className="c-sh">誤字 {T.sub}</span> ／ <span className="c-sh">脱字 {T.miss}</span> ／ <span className="c-sh">余字 {T.extra}</span>　→ 誤り合計 <b className="tf-mono text-[var(--tx)]">{T.dist}</b> 字</p>
      </Step>
      <Step no="4" title="正確率">
        <p><Fx>正確率 = 1 − 誤り合計 ÷ 照合した文字数</Fx>（区間ごとに「お手本の評価字数」と「入力字数」の大きいほうを分母に合算）</p>
        <p><Fx>1 − {T.dist} ÷ {T.denom} = {T.accuracy}%</Fx>　精度グレード <b style={{ color: 'var(--gd)' }}>{r.accGrade.id}</b>（{r.accGrade.label}）</p>
      </Step>
      <Step no="5" title="計測時間">
        {r.timing.basis === 'wall'
          ? <p>制限時間モードなので <b className="text-[var(--tx)]">開始から終了までの実時間</b>で計測します。<Fx>{r.timing.sec} 秒</Fx>{r.timing.finishedBy === 'timeup' ? '（時間いっぱいまで測定）' : '（時間内に終了）'}</p>
          : <p>自由練習・即死モードでは、<b className="text-[var(--tx)]">{r.timing.idleCapSec}秒を超える停止（読む・考える時間）を除いた入力時間</b>で計測します。<Fx>{r.timing.sec} 秒</Fx>（最後に文字を確定した時点まで。画面を開いていた実時間は {r.timing.wallSec} 秒）</p>}
      </Step>
      <Step no="6" title="速度（正味）">
        <p><Fx>正味速度 = 正解した字数 ÷ 計測時間(分)</Fx>　誤字・余字は速度に加算されません。訂正に使った時間は計測時間に含まれるので、直す手間もきちんと反映されます。</p>
        <p><Fx>{T.ok} ÷ {min.toFixed(2)}分 = {r.speed.netCpm} 字/分</Fx>　（参考：入力した全字数ベースの粗速度は <Fx>{T.inputLen} ÷ {min.toFixed(2)} = {r.speed.grossCpm} 字/分</Fx>）</p>
      </Step>
      <Step no="7" title="ランクの決定">
        <p>基準「{PROFILES[r.rank.profile].label}」の表で、正味速度 <b className="tf-mono text-[var(--tx)]">{r.speed.netCpm}</b> 字/分が到達している最高のランクが <b style={{ color: RANK_COLOR[r.rank.id] }}>{r.rank.id}（{r.rank.name}）</b> です。{r.rank.next ? <>次の <b>{r.rank.next.id}</b> には {r.rank.next.min} 字/分が必要で、あと <b className="tf-mono text-[var(--tx)]">{r.rank.toNext}</b> 字/分です。</> : '最上位ランクです。'}</p>
      </Step>
      <Step no="8" title="認定／参考記録の区別">
        {r.reliability.certified
          ? <p className="c-gr">次の条件をすべて満たしているため「認定」記録です：正解80字以上・計測30秒以上・正確率85%以上・制限時間モードは時間いっぱいまで測定。</p>
          : <p className="c-gd">次の理由で「参考記録」です：{r.reliability.reasons.join('／')}。ランクは表示しますが、統計的な信頼度が低い記録です。</p>}
      </Step>
      <Step no="9" title="総合スコア（1000点満点）">
        <p><Fx>速度 {r.score.speedPts}/600</Fx> + <Fx>精度 {r.score.accPts}/300</Fx> + <Fx>安定 {r.score.stabPts === null ? '算出不可' : r.score.stabPts + '/100'}</Fx> = <b className="tf-mono text-[var(--tx)]">{r.score.total}</b></p>
        <p>速度点 = 600 × 正味速度 ÷ GOD基準（{r.rank.ladder[8].min}字/分）／ 精度点 = 300 × (正確率 − 85) ÷ 15（85%以下は0点）／ 安定点 = ペース安定度。{r.score.stabPts === null ? '安定度を測るには約80秒以上の入力が必要なため、速度と精度の得点を1000点換算しています。' : ''}</p>
      </Step>
      <Step no="10" title="他のタイピングアプリとの比較目安">
        <p>ローマ字入力の打鍵数に換算すると<b className="text-[var(--tx)]"> 約 {r.speed.eqKeysPerSec} 打/秒</b>に相当します（推定：ひらがな≒1.9打、漢字≒3.9打、英数・記号≒1打で計算。±15%程度の誤差があります）。他アプリは「打鍵/秒」を基準にしているため、数字が大きく見えるのはそのためです。</p>
      </Step>
    </ol>
  );
}

function Ladder({ r }) {
  const lad = r.rank.ladder;
  return (
    <div className="grid grid-cols-9 gap-1" role="list" aria-label="ランク基準表">
      {lad.map((x, i) => {
        const reached = r.speed.netCpm >= x.min, cur = i === r.rank.idx;
        return (
          <div key={x.id} role="listitem" className="text-center rounded-lg py-2 px-0.5" style={{ background: cur ? 'rgba(216,180,94,.16)' : 'var(--p2)', border: `1px solid ${cur ? RANK_COLOR[x.id] : 'var(--ln)'}`, opacity: reached || cur ? 1 : 0.55 }}>
            <div className="font-bold text-sm" style={{ color: RANK_COLOR[x.id] }}>{x.id}</div>
            <div className="tf-mono text-[10px] c-mu">{x.min}+</div>
            <div className="tf-mono text-[10px]" style={{ color: '#6f7a88' }}>≈{((x.min * REF_KEYS_PER_CHAR) / 60).toFixed(1)}打</div>
          </div>
        );
      })}
    </div>
  );
}

function ResultView({ result: r, history, settings, onRetry, onHome, onDrill, toast, onOpenMethod }) {
  const [coach, setCoach] = useState(null);
  const [busy, setBusy] = useState('');
  const [err, setErr] = useState('');
  const [kindFilter, setKindFilter] = useState('all');
  const [showAll, setShowAll] = useState(false);
  const prevBest = history.filter((h) => h.id !== r.id).reduce((m, h) => Math.max(m, h.speed.netCpm), 0);
  const newBest = r.speed.netCpm > prevBest && prevBest > 0;
  const col = RANK_COLOR[r.rank.id];
  const kinds = Object.entries(r.typeCounts).sort((a, b) => b[1] - a[1]);
  const blocks = r.blocks.filter((b) => kindFilter === 'all' || b.kind === kindFilter);
  const shown = showAll ? blocks : blocks.slice(0, 20);

  const runCoach = async () => {
    setBusy('coach'); setErr('');
    try { setCoach(await aiCoach({ result: r })); } catch (e) { setErr(`${e?.message || 'AI分析に失敗しました'}。時間をおいて再度お試しください。`); } finally { setBusy(''); }
  };
  const runDrill = async () => {
    setBusy('drill'); setErr('');
    const focus = [...new Set(Object.entries(r.pairCounts).sort((a, b) => b[1] - a[1]).map(([k]) => k.split('→')[0]).concat(r.blocks.filter((b) => b.target).map((b) => b.target)).filter((t) => toG(t).length <= 6))].slice(0, 10).join('、');
    try {
      const m = await aiGenerateMaterial({ theme: '苦手語句の克服（読み物として自然な文章で）', genre: 'エッセイ', difficulty: '標準（新聞程度の漢字密度）', chars: 600, style: 'です・ます調', focus: focus || '（特になし）' });
      onDrill({ title: `${r.title}・苦手克服`, text: m.text, source: 'ai' });
    } catch (e) { setErr(`${e?.message || '教材生成に失敗しました'}`); } finally { setBusy(''); }
  };

  return (
    <div className="max-w-5xl mx-auto px-4 py-6 space-y-5">
      {/* ヒーロー */}
      <section className="tf-card p-6 sm:p-8 tf-pop" aria-label="結果の要約">
        <div className="flex flex-col sm:flex-row items-center sm:items-stretch gap-6">
          <div className="flex flex-col items-center justify-center sm:w-52 shrink-0">
            <div className="tf-h mb-1">速度ランク</div>
            <div className="font-black leading-none tf-serif" style={{ fontSize: r.rank.id.length > 2 ? '4.2rem' : '5.5rem', color: col, textShadow: `0 0 34px ${col}55` }}>{r.rank.id}</div>
            <div className="mt-2 text-sm font-semibold">{r.rank.name}</div>
            <div className="mt-2 text-xs px-2.5 py-1 rounded-full" style={{ background: r.reliability.certified ? 'rgba(127,192,138,.14)' : 'rgba(216,180,94,.14)', color: r.reliability.certified ? 'var(--gr)' : 'var(--gd)' }}>{r.reliability.certified ? '認定記録' : '参考記録'}</div>
          </div>
          <div className="flex-1 w-full">
            <div className="text-sm c-mu mb-3 truncate">{r.title} ・ {MODES[r.mode]?.label} ・ {fmtDate(r.at)}</div>
            <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
              <div className="tf-card2 p-3"><div className="tf-h">正味速度</div><div className="tf-mono text-3xl font-bold">{r.speed.netCpm}</div><div className="tf-h">字/分{newBest && <b className="c-gd ml-1">自己ベスト更新</b>}</div></div>
              <div className="tf-card2 p-3"><div className="tf-h">正確率</div><div className="tf-mono text-3xl font-bold" style={{ color: r.totals.accuracy >= 97 ? 'var(--gr)' : r.totals.accuracy >= 90 ? 'var(--gd)' : 'var(--sh)' }}>{r.totals.accuracy}<span className="text-base">%</span></div><div className="tf-h">精度 {r.accGrade.id}・{r.accGrade.label}</div></div>
              <div className="tf-card2 p-3"><div className="tf-h">総合スコア</div><div className="tf-mono text-3xl font-bold c-gd">{r.score.total}</div><div className="tf-h">/ 1000</div></div>
              <div className="tf-card2 p-3"><div className="tf-h">誤り</div><div className="tf-mono text-3xl font-bold">{r.totals.dist}<span className="text-base c-mu">字</span></div><div className="tf-h">誤{r.totals.sub} 脱{r.totals.miss} 余{r.totals.extra}</div></div>
            </div>
            <div className="mt-3 text-sm c-mu">{r.rank.next ? <>次の <b style={{ color: RANK_COLOR[r.rank.next.id] }}>{r.rank.next.id}</b> まで あと <b className="tf-mono text-[var(--tx)]">{r.rank.toNext}</b> 字/分。</> : '最上位ランクに到達しています。'} 正味速度＝正解した文字数÷分。ローマ字ではなく変換後の日本語文字で判定しています。</div>
            {!r.reliability.certified && <div className="mt-2 text-xs c-gd flex gap-1.5"><Ic n="warn" s={14} className="shrink-0 mt-0.5" />参考記録の理由：{r.reliability.reasons.join('／')}</div>}
          </div>
        </div>
        <div className="flex flex-wrap gap-2 mt-6">
          <button className="tf-btn tf-btn-main" onClick={onRetry}><Ic n="retry" />もう一度</button>
          <button className="tf-btn" onClick={onHome}><Ic n="book" />別の文章で練習</button>
          <button className="tf-btn tf-btn-ai" onClick={runDrill} disabled={!!busy || r.totals.dist === 0}>{busy === 'drill' ? <Spinner /> : <Ic n="spark" />}苦手克服の教材をAIで作る</button>
          <button className="tf-btn" onClick={() => { navigator.clipboard?.writeText(buildReport(r)).then(() => toast('レポートをコピーしました', 'ok')).catch(() => toast('コピーできませんでした', 'error')); }}><Ic n="copy" />レポートをコピー</button>
          <button className="tf-btn" onClick={() => window.print()}><Ic n="print" />印刷</button>
        </div>
        {err && <div className="mt-3 text-sm c-sh flex gap-2" role="alert"><Ic n="warn" className="mt-0.5" />{err}</div>}
      </section>

      {/* 判定根拠 */}
      <section className="tf-card p-5 sm:p-6" aria-labelledby="h-ev">
        <div className="flex items-center justify-between mb-4"><h2 id="h-ev" className="font-bold text-base flex items-center gap-2"><Ic n="shield" className="c-ai" />この判定の根拠</h2><button className="tf-btn !py-1 !text-xs" onClick={onOpenMethod}>基準表・方式の詳細</button></div>
        <Evidence r={r} />
        <div className="mt-5"><div className="tf-h mb-2">ランク基準表（{PROFILES[r.rank.profile].label}）：正味速度 字/分 と、ローマ字換算の目安 打/秒</div><Ladder r={r} /></div>
      </section>

      {/* 文字種別 */}
      <section className="grid md:grid-cols-2 gap-5">
