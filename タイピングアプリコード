  const avgAcc = history.length ? (history.reduce((a, h) => a + h.totals.accuracy, 0) / history.length).toFixed(1) : '—';
  const trend = [...history].reverse().map((h, i) => ({ t: i + 1, cpm: h.speed.netCpm }));
  return (
    <Modal open={open} onClose={onClose} title="練習履歴" wide>
      <div className="grid grid-cols-3 gap-3 mb-4">
