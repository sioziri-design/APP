  const callGeminiApi = async function (rawUserInfo, files) {

    const fallbackProData = buildProfessionalReportFromText(rawUserInfo);

    try {

      const promptText = getMasterPrompt(rawUserInfo);

      const parts = \[{ text: promptText }\];

      for (let i = 0; i \< files.length; i++) {

        if (files\[i\].base64Data && files\[i\].type) {

          parts.push({

            inlineData: {

              mimeType: files\[i\].type || 'text/plain',

              data: files\[i\].base64Data

            }

          });

        }

      }

      const apiKey = "";

      const endpoint = 'https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=' + apiKey;



      const response = await fetch(endpoint, {

        method: 'POST',

        headers: { 'Content-Type': 'application/json' },

        body: JSON.stringify({

          contents: \[{ role: "user", parts: parts }\],

          generationConfig: {

            responseMimeType: 'application/json',

            responseSchema: REPORT_RESPONSE_SCHEMA,

            temperature: 0.2

          }

        })

      });

      if (!response.ok) {

        return fallbackProData;

      }

      const result = await response.json();

      const candidate = result.candidates && result.candidates\[0\];

      const jsonText = candidate && candidate.content && candidate.content.parts && candidate.content.parts\[0\] && candidate.content.parts\[0\].text;



      if (!jsonText) {

        return fallbackProData;

      }

      const sanitized = jsonText.replace(/,\\s\*(\[}\\\]\])/g, '$1');

      const parsed = JSON.parse(sanitized);

      if (!parsed.confirmationSheet || !parsed.reasonStatement) {

        return fallbackProData;

      }

      if (!parsed.phaseLogs || !Array.isArray(parsed.phaseLogs) || parsed.phaseLogs.length === 0) {

        parsed.phaseLogs = fallbackProData.phaseLogs;

      }

      return parsed;

    } catch (err) {

      console.info('Using built-in Professional Care Manager Reasoning Engine:', err);

      return fallbackProData;

    }

  };

