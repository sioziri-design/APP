        showToast(\`${fileName}.jpeg をダウンロードしました\`, 'success');

      } else if (format === 'pdf') {

        const canvas = await window.html2canvas(elementToRender, canvasOptions);

        const JsPDFCtor = (window.jspdf && window.jspdf.jsPDF) || window.jsPDF;

        const pdf = new JsPDFCtor({

          orientation: 'portrait',

          unit: 'mm',

          format: 'a4'

        });

        const breakElement = state.activeTab === 'confirmation'

          ? elementToRender.querySelector('.print-break-before')

          : null;

        if (breakElement && breakElement.offsetTop \> 0) {

          const breakOffsetTop = breakElement.offsetTop;

          const elementScrollHeight = elementToRender.scrollHeight;

          if (elementScrollHeight === 0) {

            await addCanvasToPdfWithPagination(canvas, pdf, false);

          } else {

            const breakCanvasY = Math.floor((breakOffsetTop / elementScrollHeight) \* canvas.height);

            const part1Canvas = document.createElement('canvas');

            part1Canvas.width = canvas.width;

            part1Canvas.height = breakCanvasY;

            if (part1Canvas.height \> 0) {

              const part1Ctx = part1Canvas.getContext('2d');

              if (part1Ctx) {

                part1Ctx.drawImage(canvas, 0, 0, canvas.width, breakCanvasY, 0, 0, canvas.width, breakCanvasY);

                await addCanvasToPdfWithPagination(part1Canvas, pdf, false);

              }

            }

            const part2Canvas = document.createElement('canvas');

            part2Canvas.width = canvas.width;

            part2Canvas.height = canvas.height - breakCanvasY;

            if (part2Canvas.height \> 0) {

              const part2Ctx = part2Canvas.getContext('2d');

              if (part2Ctx) {

                part2Ctx.drawImage(canvas, 0, breakCanvasY, canvas.width, canvas.height - breakCanvasY, 0, 0, canvas.width, canvas.height - breakCanvasY);

                await addCanvasToPdfWithPagination(part2Canvas, pdf, part1Canvas.height \> 0);

              }

            }

          }

        } else {

          await addCanvasToPdfWithPagination(canvas, pdf, false);

        }

        pdf.save(\`${fileName}.pdf\`);

        showToast(\`${fileName}.pdf を出力しました\`, 'success');

      }

