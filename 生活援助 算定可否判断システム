    checkboxes.forEach(function (cb) {

      const path = cb.getAttribute('data-bind-check');

      const checked = !!getNestedValue(state.reportData, path);

      cb.checked = checked;

      const box = cb.parentElement ? cb.parentElement.querySelector('.check-box-ui') : null;

      if (box) {

        if (checked) {

          box.classList.add('bg-slate-700');

