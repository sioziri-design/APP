    if (mainTextarea) {

      mainTextarea.value = SAMPLE_CASES.case1;

      state.userInfo = SAMPLE_CASES.case1;

    }

    const sampleBtns = document.querySelectorAll('.sample-case-btn');

    sampleBtns.forEach(function (btn) {

      btn.addEventListener('click', function () {

        const key = btn.getAttribute('data-sample');

        if (SAMPLE_CASES\[key\] && mainTextarea) {

          mainTextarea.value = SAMPLE_CASES\[key\];

          state.userInfo = SAMPLE_CASES\[key\];

          showToast('プロ検証用サンプル事例を読み込みました', 'info');

        }

      });

    });

    document.getElementById('btn-clear-input').addEventListener('click', function () {

      if (mainTextarea) {

        mainTextarea.value = '';

        state.userInfo = '';

      }

      state.files = \[\];

      renderFileList();

    });

    const fileInput = document.getElementById('file-upload-input');

    fileInput.addEventListener('change', function (e) {

      const selected = Array.from(e.target.files || \[\]);

      selected.forEach(function (file) {

        const reader = new FileReader();

        reader.onload = function () {

          const dataUrl = reader.result;

          const base64Data = typeof dataUrl === 'string' && dataUrl.includes(',')

            ? dataUrl.split(',')\[1\]

            : '';

          const textReader = new FileReader();

          textReader.onload = function () {

            state.files.push({

              name: file.name,

              type: file.type || 'text/plain',

              size: file.size,

              base64Data: base64Data,

              textContent: typeof textReader.result === 'string' ? textReader.result : ''

            });

            renderFileList();

          };

          textReader.readAsText(file);

        };

        reader.readAsDataURL(file);

      });

      fileInput.value = '';

    });

    document.getElementById('file-list-container').addEventListener('click', function (e) {

      const btn = e.target.closest('\[data-remove-file\]');

      if (!btn) return;

      const idx = parseInt(btn.getAttribute('data-remove-file'), 10);

      if (!isNaN(idx)) {

        state.files.splice(idx, 1);

        renderFileList();

      }

    });

    document.getElementById('btn-close-error').addEventListener('click', function () {

      document.getElementById('error-banner').classList.add('hidden');

    });

    document.getElementById('btn-generate-report').addEventListener('click', handleGenerateReport);

    document.getElementById('tab-btn-confirmation').addEventListener('click', function () {

      switchTab('confirmation');

    });

    document.getElementById('tab-btn-reason').addEventListener('click', function () {

      switchTab('reason');

    });

    document.getElementById('btn-toggle-analysis').addEventListener('click', function () {

      const panel = document.getElementById('analysis-log-panel');

      panel.classList.toggle('hidden');

    });

    document.getElementById('btn-export-json').addEventListener('click', function () {

      if (!state.reportData) return;

      const blob = new Blob(\[JSON.stringify(state.reportData, null, 2)\], { type: 'application/json' });

      const link = document.createElement('a');

      link.href = URL.createObjectURL(blob);

      link.download = \`生活援助算定判断データ\_${state.reportData.confirmationSheet.insuredPersonName || '利用者'}.json\`;

      document.body.appendChild(link);

      link.click();

      document.body.removeChild(link);

      URL.revokeObjectURL(link.href);

      showToast('JSONスキーマデータを出力しました', 'success');

    });

    document.getElementById('btn-reset-app').addEventListener('click', function () {

      document.getElementById('report-section').classList.add('hidden');

      document.getElementById('input-section').classList.remove('hidden');

    });

    document.getElementById('btn-export-pdf').addEventListener('click', function () {

      exportSheetAs('pdf');

    });

    document.getElementById('btn-export-jpeg').addEventListener('click', function () {

      exportSheetAs('jpeg');

    });

    document.getElementById('btn-export-docx').addEventListener('click', exportSheetAsDocx); // ADDED DOCX Event Listener

    document.getElementById('btn-export-html').addEventListener('click', exportSheetAsHtml);

    document.getElementById('btn-print-sheet').addEventListener('click', handlePrintSheet);

    document.querySelectorAll('\[data-bind\]').forEach(function (el) {

      el.addEventListener('input', function (e) {

        if (!state.reportData) return;

        const path = el.getAttribute('data-bind');

        setNestedValue(state.reportData, path, e.target.value);

        if (el.tagName === 'TEXTAREA') {

          el.style.height = 'auto';

          el.style.height = (el.scrollHeight + 4) + 'px';

        }

      });

    });

    document.querySelectorAll('input\[type="checkbox"\]\[data-bind-check\]').forEach(function (cb) {

      cb.addEventListener('change', function (e) {

        if (!state.reportData) return;

        const path = cb.getAttribute('data-bind-check');

        setNestedValue(state.reportData, path, e.target.checked);

        syncCheckboxVisuals();

      });

    });

    document.querySelectorAll('input\[type="checkbox"\]\[data-care-level\]').forEach(function (cb) {

      cb.addEventListener('change', function () {

        if (!state.reportData) return;

        const level = cb.getAttribute('data-care-level');

        setNestedValue(state.reportData, 'reasonStatement.careLevel', level);

        syncCheckboxVisuals();

      });

    });

    const modalProtocol = document.getElementById('modal-protocol');

    const openProtocol = function () {

      modalProtocol.classList.remove('hidden');

      modalProtocol.classList.add('flex');

    };

    const closeProtocol = function () {

      modalProtocol.classList.add('hidden');

      modalProtocol.classList.remove('flex');

    };

    document.getElementById('btn-open-protocol').addEventListener('click', openProtocol);

    document.getElementById('btn-close-protocol').addEventListener('click', closeProtocol);

    document.getElementById('btn-close-protocol-footer').addEventListener('click', closeProtocol);

  });

})();

</script>

</body>

</html>
