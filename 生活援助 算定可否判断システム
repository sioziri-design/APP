  const addCanvasToPdfWithPagination = async function (sourceCanvas, pdf, addNewPageBefore) {

    const pdfWidth = pdf.internal.pageSize.getWidth();

    const pdfHeight = pdf.internal.pageSize.getHeight();

    const canvasWidth = sourceCanvas.width;

    const canvasHeight = sourceCanvas.height;

    const contentHeightOnPdf = (canvasHeight \* pdfWidth) / canvasWidth;

    if (addNewPageBefore) {

      pdf.addPage();

    }

    if (contentHeightOnPdf \<= pdfHeight) {

      pdf.addImage(sourceCanvas.toDataURL('image/png'), 'PNG', 0, 0, pdfWidth, contentHeightOnPdf);

      return;

    }

    let isFirstPageOfThisChunk = true;

    let positionInCanvas = 0;

    const pageHeightInCanvasPixels = (pdfHeight \* canvasWidth) / pdfWidth;

    while (positionInCanvas \< canvasHeight) {

      if (!isFirstPageOfThisChunk) {

        pdf.addPage();

      }

      const sliceHeightInCanvasPixels = Math.min(

        pageHeightInCanvasPixels,

        canvasHeight - positionInCanvas

      );

      const sliceHeightOnPdf = (sliceHeightInCanvasPixels \* pdfWidth) / canvasWidth;

      const sliceCanvas = document.createElement('canvas');

      sliceCanvas.width = canvasWidth;

      sliceCanvas.height = sliceHeightInCanvasPixels;

      const sliceContext = sliceCanvas.getContext('2d');

      if (sliceContext) {

        sliceContext.drawImage(

          sourceCanvas,

          0, positionInCanvas,

          canvasWidth, sliceHeightInCanvasPixels,

          0, 0,

          canvasWidth, sliceHeightInCanvasPixels

        );

        pdf.addImage(sliceCanvas.toDataURL('image/png'), 'PNG', 0, 0, pdfWidth, sliceHeightOnPdf);

      }

      positionInCanvas += pageHeightInCanvasPixels;

      isFirstPageOfThisChunk = false;

    }

  };

