      };

      if (format === 'jpeg') {

        const canvas = await window.html2canvas(elementToRender, canvasOptions);

        const dataUrl = canvas.toDataURL('image/jpeg', 0.95);

        const link = document.createElement('a');

        link.href = dataUrl;

