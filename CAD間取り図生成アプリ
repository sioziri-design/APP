output_schema_specification:
  format: "YAML"
  structure:
    scale_reference:
      width_units: 1000
      aspect_ratio: "{calculated_from_image}"
    
    defaults:
      standard_wall_thickness: 150
      standard_door_width: 800
      floor_height: 2400
    
    # STRICT INVENTORY CONTROL
    inventory_check:
      total_rooms_detected: integer # HABITABLE ROOMS ONLY (e.g., LDK, Bedroom, Tatami Rm > 4.5jo). EXCLUDE Hallways, Baths, Toilets, Genkan.
      total_hallways_detected: integer # Count of corridors/roka.
      total_toilets_detected: integer
      total_wheelchairs_detected: integer
      total_sinks_detected: integer
      total_beds_nursing_detected: integer
      total_beds_standard_detected: integer
      total_futons_detected: integer
      total_dining_tables_detected: integer
      total_kotatsus_detected: integer
      total_kitchens_detected: integer
      total_cupboards_detected: integer
      total_washbasins_detected: integer
      total_tansus_detected: integer
      total_washing_machines_detected: integer
      total_stairs_detected: integer
      total_shelves_detected: integer
      total_baths_detected: integer
      total_small_tables_detected: integer
      total_doors_detected: integer
      total_folding_doors_detected: integer
      total_sliding_doors_detected: integer
    
    entities:
      walls:
        - id: "W_{unique_index}"
          start: [x1, y1]
          end: [x2, y2]
          type: "structural | partition"
      
      openings:
        - id: "D_{unique_index}"
          host_wall_id: "W_{parent_wall_id}"
          type: "single_swing_door | sliding_door | folding_door | window | opening_only"
          center_position: [x, y]
      
      fixtures:
        - id: "F_{unique_index}"
          type: "toilet | sink | tub | kitchen_counter | stove | bed_nursing | bed_standard | futon | shoe_rack | dining_table | kotatsu | cupboard | washbasin | tansu | washing_machine | stairs | shelf | bath | small_table | wheelchair"
          bounds: [[x1,y1], [x2,y2]]
          orientation: 0 | 90 | 180 | 270
          verification_note: "Visually present at [x,y]. Count confirmed." 
      
      rooms:
        - id: "R_{unique_index}"
          name: "detected_text_or_inferred_function"
          boundary_wall_ids: ["W_1", "W_2", ...]
constraints_and_validations:
  hallucination_prevention_rules:
    - "RULE: EXACT COUNT. If the image has 1 toilet, the YAML MUST have exactly 1 toilet. Generating 2 is a FATAL ERROR."
    - "RULE: NO FURNITURE WRAPPING. If a rectangle is a Cupboard/Shelf/Fridge, it is a FIXTURE, not a room enclosed by walls. DELETE WALLS wrapping fixtures."
    - "RULE: NO INTERNAL MAZES. Toilets and Baths are single polygons. No internal partitions."
  orthogonality_enforcement: "Deviation within 5 degrees MUST be corrected to 0 or 90."
instruction_to_ai: >
  ANALYZE the provided sketch.
  EXECUTE the 'hallucination_prevention_rules' strictly.
  GENERATE the YAML code block.
  
  IMPORTANT: 
  1. Do not output conversational text.
  2. Verify your counts before outputting YAML.
  3. Default undefined beds to 'bed_nursing'.
  4. Only identify 'kotatsu' if explicitly labeled 'こたつ'/'コタツ'.
  5. Only identify 'cupboard' if explicitly labeled '食器棚'.
  6. Only identify 'washbasin' if explicitly labeled '洗面台'.
  7. Only identify 'tansu' if explicitly labeled 'タンス'.
  8. Only identify 'washing_machine' if explicitly labeled '洗濯機'.
  9. Only identify 'stairs' if labeled '階段', '2階へ', or clearly drawn.
  10. Only identify 'shelf' if labeled '棚', 'ラック', 'Shelf', or 'Rack'.
  11. Only identify 'bath' if labeled 'お風呂', '浴室', 'Bath', or 'Bathroom'.
  12. Only identify 'small_table' if labeled 'テーブル（小）' or 'Table (Small)'.
  13. Only identify 'single_swing_door' if labeled 'Door' or 'ドア' or visually clear.
  14. Only identify 'folding_door' if labeled 'Folding Door' or '折り戸' or '折戸' (Common in Baths).
  15. Only identify 'sliding_door' if labeled 'Sliding Door' or '引き戸' or '引戸'.
  16. Only identify 'toilet' if labeled 'Toilet' or 'トイレ' or 'WC'.
  17. Only identify 'wheelchair' if labeled 'Wheelchair', '車いす', '車椅子' or clearly drawn.
  18. CRITICAL: If a room text says 'Flooring' or 'Tatami', INCLUDE IT in the 'name' field.
  19. CRITICAL: 'total_rooms_detected' MUST ONLY count habitable rooms (Bedrooms, Living, Dining, Tatami Rooms). DO NOT count Hallways, Toilets, Baths, Genkan, or Storage/WIC as 'rooms' in this specific counter.
  20. Detect 'Hallway' if labeled '廊下'/'ろうか' or if it is a connecting passage.
final_assertion:
  model_must_confirm:
    - "I have not added any object not visibly present in the sketch."
    - "I have correctly classified all special Japanese furniture types."
    - "I have removed all unnecessary walls wrapping furniture."
    - "I have verified that 1 sketch object = 1 yaml object (No duplicates)."
`;

