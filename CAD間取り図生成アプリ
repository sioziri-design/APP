        };

        function App() {
            const [appState, setAppState] = useState(AppState.IDLE);
            const [sketchImage, setSketchImage] = useState(null);
            const [blueprintYaml, setBlueprintYaml] = useState('');
            const [verificationReport, setVerificationReport] = useState(null);
            const [cadImage, setCadImage] = useState(null);
            const [error, setError] = useState(null);
            const [userFeedback, setUserFeedback] = useState('');
            const [isSketchModalOpen, setIsSketchModalOpen] = useState(false);
            const [autoAuditEnabled, setAutoAuditEnabled] = useState(true);

            const quickFeedbackChips = [
                "食器棚・冷蔵庫の周囲の不要な壁を削除して",
                "トイレの重複を1つに修正して",
                "ベッドを介護用シングルベッド(枕1つ)にして",
                "浴室のドアを折り戸(folding_door)にして",
                "和室に(Tatami)、洋室に(Flooring)を明記して"
            ];

            const handleImageSelected = useCallback(async (base64) => {
                setSketchImage(base64);
                setAppState(AppState.ANALYZING);
                setError(null);
                setBlueprintYaml('');
                setVerificationReport(null);
                setCadImage(null);
                setUserFeedback('');

                try {
                    const yaml = await generateBlueprint(base64);
                    setBlueprintYaml(yaml);

                    if (autoAuditEnabled) {
                        setAppState(AppState.VERIFYING_BLUEPRINT);
                        try {
                            const report = await verifyBlueprint(base64, yaml, '');
                            setVerificationReport(report);
                            setAppState(AppState.BLUEPRINT_VERIFIED);
                        } catch (verifyErr) {
                            setAppState(AppState.BLUEPRINT_READY);
                        }
                    } else {
                        setAppState(AppState.BLUEPRINT_READY);
                    }
                } catch (e) {
                    setError(`スケッチの構造解析に失敗しました: ${e.message || '再試行してください'}`);
                    setAppState(AppState.ERROR);
                }
            }, [autoAuditEnabled]);

            const handleVerifyBlueprint = useCallback(async () => {
                if (!sketchImage || !blueprintYaml) return;
                setAppState(AppState.VERIFYING_BLUEPRINT);
                setError(null);

                try {
                    const report = await verifyBlueprint(sketchImage, blueprintYaml, userFeedback);
                    setVerificationReport(report);
                    setAppState(AppState.BLUEPRINT_VERIFIED);
                } catch (e) {
                    setError(`ブループリント監査中にエラーが発生しました: ${e.message || ''}`);
                    setAppState(AppState.BLUEPRINT_READY);
                }
            }, [sketchImage, blueprintYaml, userFeedback]);

            const handleRegenerateBlueprint = useCallback(async () => {
                if (!sketchImage) return;
                setAppState(AppState.ANALYZING);
                setError(null);
                const previousReport = verificationReport;
                setVerificationReport(null);
                setCadImage(null);

                try {
                    const yaml = await generateBlueprint(sketchImage, userFeedback, previousReport || undefined);
                    setBlueprintYaml(yaml);

                    if (autoAuditEnabled) {
                        setAppState(AppState.VERIFYING_BLUEPRINT);
                        const newReport = await verifyBlueprint(sketchImage, yaml, userFeedback);
                        setVerificationReport(newReport);
                        setAppState(AppState.BLUEPRINT_VERIFIED);
                    } else {
                        setAppState(AppState.BLUEPRINT_READY);
                    }
                } catch (e) {
                    setError(`ブループリントの再生成に失敗しました: ${e.message || ''}`);
                    setAppState(AppState.ERROR);
                }
            }, [sketchImage, userFeedback, verificationReport, autoAuditEnabled]);

            const handleGenerateCad = useCallback(async () => {
                if (!sketchImage || !blueprintYaml) return;
                setAppState(AppState.GENERATING_CAD);
                setError(null);

                try {
                    const imageUrl = await generateCadImage(sketchImage, blueprintYaml, userFeedback);
                    setCadImage(imageUrl);
                    setAppState(AppState.COMPLETE);
                } catch (e) {
                    setError(`CAD図面のレンダリングに失敗しました: ${e.message || 'もう一度お試しください'}`);
                    setAppState(verificationReport ? AppState.BLUEPRINT_VERIFIED : AppState.BLUEPRINT_READY);
                }
            }, [sketchImage, blueprintYaml, userFeedback, verificationReport]);

            const handleReset = useCallback(() => {
                setAppState(AppState.IDLE);
                setSketchImage(null);
                setBlueprintYaml('');
                setVerificationReport(null);
                setCadImage(null);
                setError(null);
                setUserFeedback('');
            }, []);

            const getScoreColor = (score) => {
                if (score >= 90) return 'text-emerald-400';
                if (score >= 70) return 'text-amber-400';
                return 'text-rose-400';
            };

            return (
                <div className="flex flex-col min-h-screen lg:h-screen bg-slate-100 font-sans text-slate-900">
