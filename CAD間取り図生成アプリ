                            <div className="bg-white rounded-xl shadow-sm border border-slate-200 flex flex-col flex-1 overflow-hidden">
                                <div className="px-4 py-2.5 border-b border-slate-100 flex items-center justify-between bg-slate-50">
                                    <span className="font-bold text-slate-800 text-xs sm:text-sm">Input Sketch</span>
                                    {sketchImage && (
                                        <div className="flex items-center gap-1.5">
                                            <button onClick={() => setIsSketchModalOpen(true)} className="text-[11px] font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 px-2 py-1 rounded-md flex items-center gap-1">
