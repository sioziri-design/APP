                const posMatch = block.match(/center_position:\s*\[\s*(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)\s*\]/);
                if (posMatch) {
                    openings.push({
                        id: `D_${idx + 1}`,
                        type: typeMatch ? typeMatch[1] : 'door',
                        x: parseFloat(posMatch[1]),
                        y: parseFloat(posMatch[2])
                    });
                }
            });

            const rooms = [];
            const roomBlocks = yamlText.split(/-\s*id:\s*["']?R_/i).slice(1);
            roomBlocks.forEach((block, idx) => {
                const nameMatch = block.match(/name:\s*["']?([^"'\n]+)["']?/i);
                if (nameMatch) {
                    rooms.push({ id: `R_${idx + 1}`, name: nameMatch[1].trim() });
                }
            });

            return { inventory, walls, fixtures, openings, rooms };
        };

        const InteractiveSketchModal = ({ isOpen, onClose, onApplySketch }) => {
            const canvasRef = useRef(null);
            const [tool, setTool] = useState('wall');
            const [selectedStamp, setSelectedStamp] = useState('ベッド');
            const [isDrawing, setIsDrawing] = useState(false);
            const [startPos, setStartPos] = useState({ x: 0, y: 0 });
            const [snapshot, setSnapshot] = useState(null);

            const stamps = [
                { label: 'ベッド (介護)', text: 'ベッド', w: 140, h: 90 },
                { label: 'Bed ② (一般)', text: 'Bed ②', w: 140, h: 100 },
                { label: '車いす', text: '車いす', w: 75, h: 75 },
                { label: 'トイレ (WC)', text: 'トイレ', w: 80, h: 110 },
                { label: '浴室 (お風呂)', text: '浴室', w: 150, h: 150 },
                { label: 'キッチン', text: 'キッチン', w: 190, h: 70 },
                { label: '食器棚', text: '食器棚', w: 120, h: 45 },
                { label: 'テーブル', text: 'テーブル', w: 150, h: 100 },
                { label: 'こたつ', text: 'こたつ', w: 120, h: 120 },
                { label: '洗面台', text: '洗面台', w: 75, h: 50 },
                { label: '洗濯機', text: '洗濯機', w: 65, h: 65 },
                { label: 'タンス', text: 'タンス', w: 110, h: 45 },
                { label: '階段', text: '階段', w: 90, h: 180 },
                { label: '和室 (畳)', text: '和室 (畳)', w: 0, h: 0 },
                { label: '洋室 (フローリング)', text: '洋室 (フローリング)', w: 0, h: 0 },
                { label: '廊下', text: '廊下', w: 0, h: 0 },
                { label: '玄関', text: '玄関', w: 0, h: 0 },
                { label: 'ドア', text: 'ドア', w: 60, h: 60 },
                { label: '引き戸', text: '引き戸', w: 80, h: 20 },
                { label: '折り戸', text: '折り戸', w: 60, h: 35 }
            ];

            const initCanvas = useCallback(() => {
                const canvas = canvasRef.current;
                if (!canvas) return;
                const ctx = canvas.getContext('2d');
                ctx.fillStyle = '#ffffff';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                ctx.strokeStyle = '#f1f5f9';
                ctx.lineWidth = 1;
                for (let x = 0; x < canvas.width; x += 40) {
                    ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke();
                }
                for (let y = 0; y < canvas.height; y += 40) {
                    ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke();
                }
            }, []);

            useEffect(() => {
                if (isOpen) {
                    setTimeout(initCanvas, 50);
                }
            }, [isOpen, initCanvas]);

            if (!isOpen) return null;

            const getCoords = (e) => {
                const canvas = canvasRef.current;
                const rect = canvas.getBoundingClientRect();
                const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                return {
                    x: ((clientX - rect.left) / rect.width) * canvas.width,
                    y: ((clientY - rect.top) / rect.height) * canvas.height
                };
            };

            const handlePointerDown = (e) => {
                const canvas = canvasRef.current;
                const ctx = canvas.getContext('2d');
                const pos = getCoords(e);

                if (tool === 'stamp') {
                    const item = stamps.find(s => s.label === selectedStamp) || stamps[0];
                    ctx.save();
                    ctx.strokeStyle = '#1e293b';
                    ctx.fillStyle = '#0f172a';
                    ctx.lineWidth = 3;
                    if (item.w > 0 && item.h > 0) {
                        ctx.strokeRect(pos.x - item.w / 2, pos.y - item.h / 2, item.w, item.h);
                    }
                    ctx.font = 'bold 20px sans-serif';
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.fillText(item.text, pos.x, pos.y);
                    ctx.restore();
                    return;
                }

                setIsDrawing(true);
                setStartPos(pos);
                setSnapshot(ctx.getImageData(0, 0, canvas.width, canvas.height));

                if (tool === 'pen' || tool === 'eraser') {
                    ctx.beginPath();
                    ctx.moveTo(pos.x, pos.y);
                }
            };

            const handlePointerMove = (e) => {
                if (!isDrawing) return;
                const canvas = canvasRef.current;
                const ctx = canvas.getContext('2d');
                const pos = getCoords(e);

                if (tool === 'pen') {
                    ctx.strokeStyle = '#1e293b';
                    ctx.lineWidth = 5;
                    ctx.lineCap = 'round';
                    ctx.lineTo(pos.x, pos.y);
                    ctx.stroke();
                } else if (tool === 'eraser') {
                    ctx.strokeStyle = '#ffffff';
                    ctx.lineWidth = 28;
                    ctx.lineCap = 'round';
                    ctx.lineTo(pos.x, pos.y);
                    ctx.stroke();
                } else if (tool === 'wall' && snapshot) {
                    ctx.putImageData(snapshot, 0, 0);
                    ctx.strokeStyle = '#0f172a';
                    ctx.lineWidth = 7;
                    ctx.strokeRect(
                        Math.min(startPos.x, pos.x),
                        Math.min(startPos.y, pos.y),
                        Math.abs(pos.x - startPos.x),
                        Math.abs(pos.y - startPos.y)
                    );
                }
            };

            const handlePointerUp = () => {
                setIsDrawing(false);
            };

            const handleExport = () => {
                const canvas = canvasRef.current;
                if (canvas) {
                    onApplySketch(canvas.toDataURL('image/png'));
                    onClose();
                }
            };

            return (
                <div className="fixed inset-0 z-50 bg-slate-900/75 backdrop-blur-sm flex items-center justify-center p-4">
                    <div className="bg-white rounded-2xl shadow-2xl border border-slate-200 max-w-5xl w-full overflow-hidden flex flex-col max-h-[92vh]">
                        <div className="px-6 py-4 bg-slate-900 text-white flex items-center justify-between">
                            <div className="flex items-center gap-3">
                                <PenTool className="w-5 h-5 text-sky-400" />
                                <div>
                                    <h3 className="font-bold text-base">インタラクティブ手描き間取りスケッチパッド</h3>
                                    <p className="text-xs text-slate-400">矩形壁ツールと建築スタンプで素早く手描き風の間取りを作成し、AI解析へ送信できます</p>
                                </div>
                            </div>
                            <button onClick={onClose} className="text-slate-400 hover:text-white text-sm px-3 py-1 rounded-lg bg-slate-800">
                                閉じる
                            </button>
                        </div>

                        <div className="p-4 bg-slate-50 border-b border-slate-200 flex flex-wrap items-center justify-between gap-3">
                            <div className="flex items-center gap-2">
                                <button onClick={() => setTool('wall')} className={`px-3 py-2 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all ${tool === 'wall' ? 'bg-sky-600 text-white shadow-sm' : 'bg-white text-slate-700 border border-slate-200'}`}>
                                    <Box className="w-3.5 h-3.5" /> 部屋・壁 (ドラッグで矩形)
                                </button>
                                <button onClick={() => setTool('pen')} className={`px-3 py-2 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all ${tool === 'pen' ? 'bg-sky-600 text-white shadow-sm' : 'bg-white text-slate-700 border border-slate-200'}`}>
                                    <PenTool className="w-3.5 h-3.5" /> フリーハンド線
                                </button>
                                <button onClick={() => setTool('stamp')} className={`px-3 py-2 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all ${tool === 'stamp' ? 'bg-sky-600 text-white shadow-sm' : 'bg-white text-slate-700 border border-slate-200'}`}>
                                    <PlusCircle className="w-3.5 h-3.5" /> 設備・部屋名スタンプ
                                </button>
                                <button onClick={() => setTool('eraser')} className={`px-3 py-2 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all ${tool === 'eraser' ? 'bg-rose-600 text-white shadow-sm' : 'bg-white text-slate-700 border border-slate-200'}`}>
                                    <Trash2 className="w-3.5 h-3.5" /> 消しゴム
                                </button>
                            </div>

                            {tool === 'stamp' && (
                                <div className="flex items-center gap-2">
                                    <span className="text-xs font-medium text-slate-500">配置スタンプ:</span>
                                    <select value={selectedStamp} onChange={(e) => setSelectedStamp(e.target.value)} className="text-xs bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 font-semibold text-slate-800">
                                        {stamps.map((s) => (
                                            <option key={s.label} value={s.label}>{s.label}</option>
                                        ))}
                                    </select>
                                </div>
                            )}

                            <div className="flex items-center gap-2">
                                <button onClick={initCanvas} className="px-3 py-1.5 rounded-lg text-xs font-medium bg-white border border-slate-200 text-slate-600 hover:bg-slate-100">
                                    全消去
                                </button>
                                <button onClick={handleExport} className="px-4 py-2 rounded-lg text-xs font-bold bg-sky-600 text-white hover:bg-sky-700 shadow-md flex items-center gap-1.5">
                                    <Check className="w-4 h-4" /> このスケッチをAI解析する
                                </button>
                            </div>
                        </div>

                        <div className="flex-1 bg-slate-200 p-4 flex items-center justify-center overflow-auto">
                            <canvas
                                ref={canvasRef}
                                width={900}
                                height={600}
                                onMouseDown={handlePointerDown}
                                onMouseMove={handlePointerMove}
                                onMouseUp={handlePointerUp}
                                onMouseLeave={handlePointerUp}
                                onTouchStart={handlePointerDown}
                                onTouchMove={handlePointerMove}
                                onTouchEnd={handlePointerUp}
                                className="bg-white rounded-xl shadow-lg border border-slate-300 cursor-crosshair max-w-full h-auto"
                            />
                        </div>
                    </div>
                </div>
            );
        };

        const ImageUpload = ({ onImageSelected, onOpenSketchPad }) => {
            const handleFileChange = useCallback((event) => {
                const file = event.target.files?.[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onloadend = () => {
                        const result = reader.result;
                        if (file.type === 'image/svg+xml' || file.name.toLowerCase().endsWith('.svg')) {
                            const img = new Image();
                            img.onload = () => {
                                const canvas = document.createElement('canvas');
                                canvas.width = img.width || 1000;
                                canvas.height = img.height || 1000;
                                const ctx = canvas.getContext('2d');
                                if (ctx) {
                                    ctx.fillStyle = '#ffffff';
                                    ctx.fillRect(0, 0, canvas.width, canvas.height);
                                    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                                    const pngData = canvas.toDataURL('image/png');
                                    onImageSelected(pngData);
                                }
                            };
                            img.src = result;
                        } else {
                            onImageSelected(result);
                        }
                    };
                    reader.readAsDataURL(file);
                }
            }, [onImageSelected]);

            const handleLoadSample = (presetId) => {
                const sampleDataUrl = createSampleSketchDataUrl(presetId);
                if (sampleDataUrl) {
                    onImageSelected(sampleDataUrl);
                }
            };

            return (
                <div className="w-full h-full flex flex-col items-center justify-between p-4 border-2 border-dashed border-slate-300 rounded-xl bg-slate-50/70 hover:bg-slate-100/70 transition-colors">
                    <div className="flex flex-col items-center justify-center my-auto text-center">
                        <div className="bg-white p-3.5 rounded-full shadow-sm mb-3 border border-slate-100">
                            <Upload className="w-7 h-7 text-sky-600" />
                        </div>
                        <h3 className="text-sm font-bold text-slate-800 mb-1">手描き間取りスケッチを入力</h3>
                        <p className="text-slate-500 text-center mb-4 max-w-xs text-xs leading-relaxed">
                            手書きの平面図画像（JPG, PNG, SVG）をアップロードするか、下のサンプル／作図パッドで即座にテストできます。
                        </p>

                        <div className="flex flex-wrap items-center justify-center gap-2">
                            <input
                                type="file"
                                accept="image/png, image/jpeg, image/jpg, image/webp, image/svg+xml"
                                onChange={handleFileChange}
                                className="hidden"
                                id="file-upload"
                            />
                            <label htmlFor="file-upload" className="cursor-pointer bg-sky-600 text-white px-4 py-2 rounded-lg text-xs font-semibold hover:bg-sky-700 transition-colors shadow-sm flex items-center gap-1.5">
                                <Upload className="w-3.5 h-3.5" /> ファイルを選択
                            </label>
                            <button onClick={onOpenSketchPad} className="bg-slate-800 text-white px-3.5 py-2 rounded-lg text-xs font-semibold hover:bg-slate-900 transition-colors shadow-sm flex items-center gap-1.5">
                                <PenTool className="w-3.5 h-3.5" /> その場で手描き作図
                            </button>
                        </div>
                    </div>

                    <div className="w-full pt-3 border-t border-slate-200/80">
                        <p className="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2 text-center">
                            ワンクリック検証用サンプルスケッチ
                        </p>
                        <div className="grid grid-cols-3 gap-1.5">
                            <button onClick={() => handleLoadSample('nursing_home')} className="p-2 rounded-lg bg-white hover:bg-sky-50 border border-slate-200 hover:border-sky-300 text-left transition-all group">
                                <div className="text-[11px] font-bold text-slate-700 group-hover:text-sky-700 truncate">① 介護・車いす邸</div>
                                <div className="text-[10px] text-slate-400 truncate">車椅子・介護ベッド・廊下</div>
                            </button>
                            <button onClick={() => handleLoadSample('japanese_washitsu')} className="p-2 rounded-lg bg-white hover:bg-sky-50 border border-slate-200 hover:border-sky-300 text-left transition-all group">
                                <div className="text-[11px] font-bold text-slate-700 group-hover:text-sky-700 truncate">② 和室・こたつ邸</div>
                                <div className="text-[10px] text-slate-400 truncate">畳・布団・タンス・階段</div>
                            </button>
                            <button onClick={() => handleLoadSample('urban_1ldk')} className="p-2 rounded-lg bg-white hover:bg-sky-50 border border-slate-200 hover:border-sky-300 text-left transition-all group">
                                <div className="text-[11px] font-bold text-slate-700 group-hover:text-sky-700 truncate">③ 都市型1LDK</div>
                                <div className="text-[10px] text-slate-400 truncate">Bed②・UB・対面LDK</div>
                            </button>
                        </div>
                    </div>
                </div>
            );
        };

        const BlueprintDisplay = ({ yaml, onChangeYaml, loading }) => {
            const [activeTab, setActiveTab] = useState('yaml');
            const [isEditing, setIsEditing] = useState(false);
            const [copied, setCopied] = useState(false);

            const parsed = useMemo(() => parseYamlBlueprint(yaml), [yaml]);

            const handleCopy = () => {
                if (!yaml) return;
                const textArea = document.createElement("textarea");
                textArea.value = yaml;
                document.body.appendChild(textArea);
                textArea.select();
                document.execCommand("copy");
                document.body.removeChild(textArea);
                setCopied(true);
                setTimeout(() => setCopied(false), 2000);
            };

            const handleDownloadYaml = () => {
                if (!yaml) return;
                const blob = new Blob([yaml], { type: 'text/yaml;charset=utf-8' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = 'structural-blueprint.yaml';
                a.click();
                URL.revokeObjectURL(url);
            };

            const activeInventoryEntries = Object.entries(parsed.inventory).filter(([, val]) => val > 0);

            return (
                <div className="flex flex-col h-full bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                    <div className="px-4 py-2.5 border-b border-slate-100 flex items-center justify-between bg-slate-50 flex-wrap gap-2">
                        <div className="flex items-center gap-2">
                            <Code className="w-4 h-4 text-sky-600" />
                            <h3 className="font-bold text-slate-800 text-xs sm:text-sm">Phase 1: Structural Blueprint</h3>
                        </div>

                        {yaml && (
                            <div className="flex items-center gap-1 bg-slate-200/70 p-0.5 rounded-lg">
                                <button onClick={() => setActiveTab('yaml')} className={`px-2.5 py-1 rounded-md text-xs font-semibold transition-all ${activeTab === 'yaml' ? 'bg-white text-slate-800 shadow-sm' : 'text-slate-600 hover:text-slate-900'}`}>
                                    YAMLコード
                                </button>
                                <button onClick={() => setActiveTab('vector')} className={`px-2.5 py-1 rounded-md text-xs font-semibold transition-all flex items-center gap-1 ${activeTab === 'vector' ? 'bg-white text-sky-700 shadow-sm' : 'text-slate-600 hover:text-slate-900'}`}>
                                    <Grid className="w-3 h-3" /> 2D幾何プレビュー
                                </button>
                                <button onClick={() => setActiveTab('inventory')} className={`px-2.5 py-1 rounded-md text-xs font-semibold transition-all flex items-center gap-1 ${activeTab === 'inventory' ? 'bg-white text-emerald-700 shadow-sm' : 'text-slate-600 hover:text-slate-900'}`}>
                                    <Layers className="w-3 h-3" /> 検出インベントリ ({activeInventoryEntries.length})
                                </button>
                            </div>
                        )}

                        {yaml && (
                            <div className="flex items-center gap-1">
                                {activeTab === 'yaml' && (
                                    <button onClick={() => setIsEditing(!isEditing)} title="YAMLを手動編集" className={`p-1.5 rounded-lg text-xs font-medium flex items-center gap-1 border ${isEditing ? 'bg-amber-50 border-amber-300 text-amber-700' : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-100'}`}>
                                        <Edit3 className="w-3.5 h-3.5" />
                                        <span className="hidden sm:inline">{isEditing ? '編集完了' : '手動補正'}</span>
                                    </button>
                                )}
                                <button onClick={handleCopy} title="YAMLをコピー" className="p-1.5 rounded-lg bg-white border border-slate-200 text-slate-600 hover:bg-slate-100 text-xs">
                                    {copied ? <Check className="w-3.5 h-3.5 text-emerald-600" /> : <Copy className="w-3.5 h-3.5" />}
                                </button>
                                <button onClick={handleDownloadYaml} title="YAMLを保存" className="p-1.5 rounded-lg bg-white border border-slate-200 text-slate-600 hover:bg-slate-100 text-xs">
                                    <Download className="w-3.5 h-3.5" />
                                </button>
                            </div>
                        )}
                    </div>

                    <div className="flex-1 overflow-auto p-0 relative bg-slate-950">
                        {loading ? (
                            <div className="absolute inset-0 flex items-center justify-center bg-slate-900/90 backdrop-blur-sm z-10">
                                <div className="flex flex-col items-center text-center p-6">
                                    <div className="w-10 h-10 border-4 border-sky-400/30 border-t-sky-400 rounded-full animate-spin mb-3"></div>
                                    <p className="text-sm font-bold text-sky-300 animate-pulse">幾何構造と設備シンボルを厳密解析中...</p>
                                    <p className="text-xs text-slate-400 mt-1">重複排除プロトコル・壁囲い排除ルール・福祉機器判定を適用しています</p>
                                </div>
                            </div>
                        ) : null}

                        {!yaml ? (
                            <div className="h-full flex flex-col items-center justify-center text-slate-400 p-8 bg-white">
                                <FileText className="w-12 h-12 mb-3 opacity-20" />
                                <p className="text-sm font-medium text-center text-slate-500">手描きスケッチの入力を待機中...</p>
                                <p className="text-xs text-slate-400 text-center mt-1">左パネルから画像をアップロードするか、ワンクリック検証サンプルを選択してください</p>
                            </div>
                        ) : activeTab === 'yaml' ? (
                            isEditing ? (
                                <textarea
                                    value={yaml}
                                    onChange={(e) => onChangeYaml(e.target.value)}
                                    className="w-full h-full p-4 bg-slate-950 text-amber-200 font-mono text-xs leading-relaxed outline-none resize-none"
                                    spellCheck={false}
                                />
                            ) : (
                                <pre className="p-4 text-xs font-mono text-sky-100 leading-relaxed whitespace-pre-wrap select-all">
                                    {yaml}
                                </pre>
                            )
                        ) : activeTab === 'vector' ? (
                            <div className="w-full h-full flex flex-col items-center justify-center p-4 bg-slate-900">
                                <div className="w-full flex items-center justify-between text-xs text-slate-400 mb-2 px-2">
                                    <span>座標系: 1000 × 1000 正規化グリッド</span>
                                    <div className="flex items-center gap-3">
                                        <span className="flex items-center gap-1"><span className="w-2.5 h-2.5 inline-block bg-sky-400 rounded-sm"></span> 壁 ({parsed.walls.length})</span>
                                        <span className="flex items-center gap-1"><span className="w-2.5 h-2.5 inline-block bg-emerald-400 rounded-sm"></span> 設備・家具 ({parsed.fixtures.length})</span>
                                        <span className="flex items-center gap-1"><span className="w-2.5 h-2.5 inline-block bg-amber-400 rounded-full"></span> 建具・開口 ({parsed.openings.length})</span>
                                    </div>
                                </div>
                                <svg viewBox="0 0 1000 1000" className="w-full h-full max-h-[380px] bg-slate-950 rounded-lg border border-slate-800 shadow-inner">
                                    <defs>
                                        <pattern id="blueprint-grid" width="100" height="100" patternUnits="userSpaceOnUse">
                                            <path d="M 100 0 L 0 0 0 100" fill="none" stroke="#1e293b" strokeWidth="2" />
                                        </pattern>
                                    </defs>
                                    <rect width="1000" height="1000" fill="url(#blueprint-grid)" />
                                    {parsed.fixtures.map((f) => {
                                        const x = Math.min(f.x1, f.x2);
                                        const y = Math.min(f.y1, f.y2);
                                        const w = Math.max(20, Math.abs(f.x2 - f.x1));
                                        const h = Math.max(20, Math.abs(f.y2 - f.y1));
                                        return (
                                            <g key={f.id}>
                                                <rect x={x} y={y} width={w} height={h} fill="rgba(16, 185, 129, 0.18)" stroke="#10b981" strokeWidth="4" rx="6" />
                                                <text x={x + w / 2} y={y + h / 2} fill="#6ee7b7" fontSize="22" fontWeight="bold" textAnchor="middle" dominantBaseline="middle">
                                                    {f.type}
                                                </text>
