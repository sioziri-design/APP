                                        ) : (
                                            <div className="flex items-center justify-center h-full text-slate-500 flex-col gap-2 py-6">
                                                <Gauge className="w-7 h-7 animate-spin text-purple-400" />
                                                <span className="text-purple-300 animate-pulse text-xs">元スケッチとYAMLのピクセル単位監査を実行中...</span>
                                            </div>
                                        )}
                                    </div>
                                </div>
                            )}
                        </section>

                        <section className="lg:col-span-4 lg:h-full min-h-[480px] flex flex-col gap-4">
                            <div className="flex-1 min-h-[280px]">
                                <CadDisplay imageUrl={cadImage} sketchImage={sketchImage} loading={appState === AppState.GENERATING_CAD} />
                            </div>

                            <div className="bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-col gap-3">
                                {error && (
                                    <div className="p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded-lg flex items-start gap-2">
                                        <AlertCircle className="w-4 h-4 shrink-0 mt-0.5" />
                                        <div className="flex-1">{error}</div>
                                    </div>
                                )}

                                <div className="bg-slate-50 p-3 rounded-lg border border-slate-200">
                                    <div className="flex items-center justify-between mb-1.5">
                                        <div className="flex items-center gap-1.5 text-slate-700">
                                            <MessageSquare className="w-3.5 h-3.5 text-sky-600" />
                                            <span className="text-xs font-bold uppercase">Operator Instructions / 修正フィードバック</span>
                                        </div>
                                        {userFeedback && (
                                            <button onClick={() => setUserFeedback('')} className="text-[10px] text-slate-400 hover:text-slate-600">クリア</button>
                                        )}
                                    </div>

                                    <textarea className="w-full text-xs p-2 rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-sky-500 outline-none resize-none h-14" placeholder="例: 『キッチンに流し台を追加』『食器棚の周りの壁を消去』『ドアを内開きに変更』..." value={userFeedback} onChange={(e) => setUserFeedback(e.target.value)} />

                                    <div className="flex items-center gap-1 overflow-x-auto pt-2 pb-0.5 no-scrollbar">
                                        {quickFeedbackChips.map((chip) => (
                                            <button key={chip} onClick={() => setUserFeedback(prev => prev ? `${prev} / ${chip}` : chip)} className="shrink-0 text-[10px] px-2 py-1 rounded-full bg-white hover:bg-sky-50 text-slate-600 hover:text-sky-700 border border-slate-200 transition-colors">
                                                + {chip}
                                            </button>
                                        ))}
                                    </div>
                                </div>

                                <div className="flex flex-col gap-2">
                                    {appState === AppState.IDLE && (
                                        <div className="text-center py-2 text-xs text-slate-400 font-medium">スケッチをアップロードするか、サンプルを選択するとパイプラインが開始します</div>
                                    )}

                                    {appState === AppState.ERROR && (
                                        <div className="grid grid-cols-2 gap-2">
                                            <button onClick={handleRegenerateBlueprint} disabled={!sketchImage} className="py-2.5 px-4 rounded-lg font-bold text-xs flex items-center justify-center gap-1.5 bg-sky-600 text-white hover:bg-sky-700 disabled:opacity-50">
                                                <RefreshCw className="w-4 h-4" /> 再試行する
                                            </button>
                                            <button onClick={handleReset} className="py-2.5 px-4 rounded-lg font-bold text-xs flex items-center justify-center gap-1.5 bg-slate-200 text-slate-700 hover:bg-slate-300">
                                                <RotateCcw className="w-4 h-4" /> 最初からやり直す
                                            </button>
                                        </div>
                                    )}

                                    {appState === AppState.BLUEPRINT_READY && (
                                        <div className="flex flex-col gap-2">
                                            <div className="grid grid-cols-2 gap-2">
                                                <button onClick={handleVerifyBlueprint} className="py-3 px-3 rounded-lg font-bold text-xs flex items-center justify-center gap-1.5 bg-purple-600 text-white hover:bg-purple-700 shadow-md shadow-purple-600/20">
                                                    <ShieldCheck className="w-4 h-4" /> Hyper-Max 監査を実行
                                                </button>
                                                <button onClick={handleGenerateCad} className="py-3 px-3 rounded-lg font-bold text-xs flex items-center justify-center gap-1.5 bg-emerald-600 text-white hover:bg-emerald-700 shadow-md shadow-emerald-600/20">
                                                    <ArrowRight className="w-4 h-4" /> 直接CAD図面を生成
                                                </button>
                                            </div>
                                            <button onClick={handleRegenerateBlueprint} className="w-full py-2 px-4 rounded-lg font-semibold text-xs flex items-center justify-center gap-1.5 bg-slate-100 text-slate-700 hover:bg-slate-200">
                                                <RefreshCw className="w-3.5 h-3.5" /> フィードバックを反映してYAMLを再生成
                                            </button>
                                        </div>
                                    )}

                                    {appState === AppState.BLUEPRINT_VERIFIED && (
                                        <div className="grid grid-cols-2 gap-2">
                                            <button onClick={handleRegenerateBlueprint} className="py-2.5 px-4 rounded-lg font-semibold flex flex-col items-center justify-center gap-0.5 bg-amber-500 text-white hover:bg-amber-600 shadow-md shadow-amber-500/20">
                                                <div className="flex items-center gap-1 text-xs font-bold"><RefreshCw className="w-3.5 h-3.5" /> スコア改善・再生成</div>
                                                <span className="text-[10px] opacity-90">監査指摘を契約強制して再解析</span>
                                            </button>
                                            <button onClick={handleGenerateCad} className="py-2.5 px-4 rounded-lg font-semibold flex flex-col items-center justify-center gap-0.5 bg-emerald-600 text-white hover:bg-emerald-700 shadow-md shadow-emerald-600/20">
                                                <div className="flex items-center gap-1 text-xs font-bold"><ArrowRight className="w-3.5 h-3.5" /> CAD図面を生成</div>
                                                <span className="text-[10px] opacity-90">Phase 2 高精細レンダリングへ</span>
                                            </button>
                                        </div>
                                    )}

                                    {appState === AppState.COMPLETE && (
                                        <div className="grid grid-cols-3 gap-2">
                                            <button onClick={handleGenerateCad} className="py-2.5 px-3 rounded-lg font-semibold flex flex-col items-center justify-center gap-0.5 bg-purple-600 text-white hover:bg-purple-700 shadow-sm">
                                                <RefreshCw className="w-3.5 h-3.5" /> <span className="text-[11px] font-bold">CADのみ再描画</span>
                                            </button>
                                            <button onClick={handleRegenerateBlueprint} className="py-2.5 px-3 rounded-lg font-semibold flex flex-col items-center justify-center gap-0.5 bg-amber-500 text-white hover:bg-amber-600 shadow-sm">
                                                <Edit3 className="w-3.5 h-3.5" /> <span className="text-[11px] font-bold">指示反映し再解析</span>
                                            </button>
                                            <button onClick={handleReset} className="py-2.5 px-3 rounded-lg font-semibold flex flex-col items-center justify-center gap-0.5 bg-slate-200 text-slate-700 hover:bg-slate-300">
                                                <RotateCcw className="w-3.5 h-3.5" /> <span className="text-[11px] font-bold">新規プロジェクト</span>
                                            </button>
                                        </div>
                                    )}
                                </div>
                            </div>
                        </section>
                    </main>
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
